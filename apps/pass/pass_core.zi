#import "crypto/sha256"
#if #defined(WERK_APP) {
    #import "kryon/app_context"
}

PassOptions :: struct {
    length: s32
    counter: u64
    lowercase: bool
    uppercase: bool
    digits: bool
    symbols: bool
    exclude: string
}

PassClass :: struct {
    bytes: [32]u8
    count: s32
}

PassResult :: struct {
    valid: bool
    password: [36]u8
    length: s32
    error: string
}

EntropyState :: struct {
    bytes: [32]u8
}
EntropyResult :: struct {
    entropy: EntropyState
    value: s32
}

master_emoji_codepoints: [64]s32 = .[
0x1F436, 0x1F431, 0x1F42D, 0x1F439, 0x1F430, 0x1F98A, 0x1F43B, 0x1F43C,
0x1F428, 0x1F42F, 0x1F981, 0x1F42E, 0x1F437, 0x1F438, 0x1F435, 0x1F414,
0x1F427, 0x1F989, 0x1F43A, 0x1F434, 0x1F984, 0x1F41D, 0x1F98B, 0x1F422,
0x1F34E, 0x1F34A, 0x1F34B, 0x1F349, 0x1F347, 0x1F353, 0x1F352, 0x1F351,
0x1F951, 0x1F33D, 0x1F355, 0x1F354, 0x1F35F, 0x1F369, 0x1F335, 0x1F332,
0x1F333, 0x1F334, 0x1F331, 0x1F33B, 0x1F338, 0x1F308, 0x2B50, 0x1F319,
0x1F525, 0x1F4A7, 0x26C4, 0x1F389, 0x1F3B8, 0x1F3AF, 0x1F3B2, 0x1F381,
0x1F680, 0x1F697, 0x2693, 0x1F3A8, 0x1F511, 0x1F4A1, 0x1F4DA, 0x1F3A7
];


// Whether the last DeriveKey failed; only the Werkzeug host can refuse.
derive_failed: bool;

DeriveKey :: (password: string, salt: string) -> [32]u8 {
    derive_failed = false
    // Inside Werkzeug the host derives the key natively; the portable
    // interpreter would take minutes for 100,000 rounds.
    #if #defined(WERK_APP) {
        output: [32]u8
        derive_failed = !AppPbkdf2Sha256(password, salt, 100000, output[:])
        return output
    } else {
        return Pbkdf2Sha256(password, ifx salt.count > PASS_SALT_LIMIT then salt[0:PASS_SALT_LIMIT] else salt, 100000)
    }
}

// Werkzeug's key derivation has always read at most this many salt bytes,
// and existing vault keys depend on it; the host derives the same way.
PASS_SALT_LIMIT :: 508


PassClassEmptyError :: (class_index: s32) -> string {
    if class_index == 0 {
        return "enabled lowercase character class is empty after exclusions"
    }
    if class_index == 1 {
        return "enabled uppercase character class is empty after exclusions"
    }
    if class_index == 2 {
        return "enabled digits character class is empty after exclusions"
    }
    return "enabled symbols character class is empty after exclusions"
}

PassFailure :: (message: string) -> PassResult {
    result: PassResult
    result.error = message
    return result
}

PassFilterClass :: (characters: string, options: PassOptions) -> PassClass {
    result: PassClass
    character_index: s32 = 0
    while character_index < cast(s32)characters.count {
        excluded := false
        exclude_index: s32 = 0
        while exclude_index < cast(s32)options.exclude.count {
            if options.exclude[exclude_index] == characters[character_index] {
                excluded = true
                break
            }
            exclude_index += 1
        }
        if !excluded && result.count < cast(s32)result.bytes.count {
            result.bytes[result.count] = characters[character_index]
            result.count += 1
        }
        character_index += 1
    }
    return result
}

PassAppendCounter :: (salt: []u8, offset: s32, counter: u64) -> s32 {
    digits: [16]u8
    digit_count: s32 = 0
    value := counter
    while value > cast(u64)0 {
        nibble: u64 = value % cast(u64)16
        if nibble < cast(u64)10 {
            digits[digit_count] = cast(u8)(nibble + cast(u64)48)
        } else {
            digits[digit_count] = cast(u8)(nibble + cast(u64)87)
        }
        digit_count += 1
        value /= cast(u64)16
    }
    if digit_count == 0 {
        salt[offset] = cast(u8)48
        return offset + 1
    }
    digit_index: s32 = digit_count - 1
    while digit_index >= 0 {
        salt[offset + (digit_count - digit_index - 1)] = digits[digit_index]
        digit_index -= 1
    }
    return offset + digit_count
}

EntropyTake :: (entropy: EntropyState, divisor: s32) -> EntropyResult {
    carry: u32 = 0
    index: s32 = 0
    while index < 32 {
        current: u32 = carry * cast(u32)256 +
        cast(u32)entropy.bytes[index]
        entropy.bytes[index] = cast(u8)(current / cast(u32)divisor)
        carry = current % cast(u32)divisor
        index += 1
    }
    return EntropyResult.{entropy, cast(s32)carry}
}

PassGenerate :: (site: string, login: string, master: string,
    options: PassOptions) -> PassResult {
    if options.length < 5 || options.length > 35 {
        return PassFailure(
            "password length must be between 5 and 35")
    }

    class_sets: [4]string = .[
    "abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "0123456789", "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
    ]
    class_names: [4]string = .[
    "lowercase", "uppercase", "digits", "symbols"
    ]
    class_enabled: [4]bool = .[
    options.lowercase, options.uppercase,
    options.digits, options.symbols
    ]
    classes: [4]PassClass
    class_count: s32 = 0
    alphabet: [128]u8
    alphabet_count: s32 = 0
    class_index: s32 = 0
    while class_index < 4 {
        if class_enabled[class_index] {
            classes[class_count] = PassFilterClass(
                class_sets[class_index], options)
            if classes[class_count].count == 0 {
                return PassFailure(PassClassEmptyError(class_index))
            }
            copy_index: s32 = 0
            while copy_index < classes[class_count].count {
                alphabet[alphabet_count] =
                classes[class_count].bytes[copy_index]
                alphabet_count += 1
                copy_index += 1
            }
            class_count += 1
        }
        class_index += 1
    }
    if class_count == 0 {
        return PassFailure("at least one character class must be enabled")
    }
    if options.length < class_count {
        return PassFailure(
            "password length is smaller than the enabled character classes")
    }
    if options.length == class_count {
        return PassFailure(
            "password length must leave room for generated characters")
    }

    salt: [640]u8
    salt_length: s32 = 0
    if cast(s32)site.count >= cast(s32)salt.count {
        return PassFailure("site name is too long")
    }
    site_index: s32 = 0
    while site_index < cast(s32)site.count {
        salt[salt_length] = site[site_index]
        salt_length += 1
        site_index += 1
    }
    if cast(s64)salt_length + login.count + 16 > salt.count {
        return PassFailure("login is too long")
    }
    login_index: s32 = 0
    while login_index < cast(s32)login.count {
        salt[salt_length] = login[login_index]
        salt_length += 1
        login_index += 1
    }
    salt_length = PassAppendCounter(salt[:], salt_length, options.counter)

    entropy: EntropyState
    entropy.bytes = DeriveKey(master, TextView(salt[0:salt_length]))
    if derive_failed { return PassFailure("Could not derive the password") }

    password_length := options.length - class_count
    password: [36]u8
    generated_index: s32 = 0
    while generated_index < password_length {
        taken := EntropyTake(entropy, alphabet_count)
        entropy = taken.entropy
        password[generated_index] = alphabet[taken.value]
        generated_index += 1
    }

    required: [4]u8
    required_index: s32 = 0
    while required_index < class_count {
        taken := EntropyTake(entropy, classes[required_index].count)
        entropy = taken.entropy
        required[required_index] = classes[required_index].bytes[taken.value]
        required_index += 1
    }

    insertion_index: s32 = 0
    while insertion_index < class_count {
        taken := EntropyTake(entropy, password_length)
        entropy = taken.entropy
        position := taken.value
        move_index := password_length
        while move_index > position {
            password[move_index] = password[move_index - 1]
            move_index -= 1
        }
        password[position] = required[insertion_index]
        password_length += 1
        insertion_index += 1
    }

    result: PassResult
    result.valid = true
    result.length = password_length
    result_index: s32 = 0
    while result_index < password_length {
        result.password[result_index] = password[result_index]
        result_index += 1
    }
    return result
}


MasterEmojiAppendUtf8 :: (output: []u8, used: s32, codepoint: u32) -> s32 {
    if used < 0 || used >= cast(s32)output.count { return used }
    length: s32 = 0
    if codepoint <= cast(u32)0x7f {
        length = 1
    } else if codepoint <= cast(u32)0x7ff {
        length = 2
    } else if codepoint <= cast(u32)0xffff {
        length = 3
    } else if codepoint <= cast(u32)0x10ffff {
        length = 4
    } else {
        output[used] = cast(u8)0
        return used
    }

    if used + length >= cast(s32)output.count {
        output[used] = cast(u8)0
        return used
    }

    if length == 1 {
        output[used] = cast(u8)codepoint
    } else if length == 2 {
        output[used] = cast(u8)(cast(u32)0xc0 | (codepoint >> cast(u32)6))
        output[used + 1] = cast(u8)(cast(u32)0x80 |
            (codepoint & cast(u32)0x3f))
    } else if length == 3 {
        output[used] = cast(u8)(cast(u32)0xe0 | (codepoint >> cast(u32)12))
        output[used + 1] = cast(u8)(cast(u32)0x80 |
            ((codepoint >> cast(u32)6) & cast(u32)0x3f))
        output[used + 2] = cast(u8)(cast(u32)0x80 |
            (codepoint & cast(u32)0x3f))
    } else {
        output[used] = cast(u8)(cast(u32)0xf0 | (codepoint >> cast(u32)18))
        output[used + 1] = cast(u8)(cast(u32)0x80 |
            ((codepoint >> cast(u32)12) & cast(u32)0x3f))
        output[used + 2] = cast(u8)(cast(u32)0x80 |
            ((codepoint >> cast(u32)6) & cast(u32)0x3f))
        output[used + 3] = cast(u8)(cast(u32)0x80 |
            (codepoint & cast(u32)0x3f))
    }

    used += length
    output[used] = cast(u8)0
    return used
}

MasterEmoji :: (master: string, output: []u8) -> s32 {
    if output.count <= 0 { return 0 }
    output[0] = cast(u8)0

    digest := Sha256Of(master)
    used: s32 = 0
    for index: 0..3 {
        codepoint: u32 = cast(u32)master_emoji_codepoints[
        cast(s32)digest[index] & 63]
        used = MasterEmojiAppendUtf8(output, used, codepoint)
    }
    return used
}
