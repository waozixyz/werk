// Authenticator exports: otpauth links, one or many as Ente Auth and other
// apps export them, Google Authenticator's otpauth-migration links and
// Aegis's unencrypted JSON. Encrypted exports are recognized and refused.
#import "text_buffer"
#import "json_scan"
#import "totp"

EXPORT_LIMIT :: 128
MIGRATION_LIMIT :: 16384

ExportResult :: struct {
    // Accounts read into export_accounts.
    count: s32
    // Entries that are not time-based codes or could not be read.
    skipped: s32
    // The export is encrypted; only unencrypted exports can be read.
    encrypted: bool
}

export_accounts: [EXPORT_LIMIT]Account;
export_result: ExportResult;
migration_text: [MIGRATION_LIMIT]u8;
migration_bytes: [MIGRATION_LIMIT]u8;
aegis_positions: [EXPORT_LIMIT * 2]s32;

Wipe :: (bytes: []u8) {
    index: s64 = 0
    while index < bytes.count {
        bytes[index] = cast(u8)0
        index += 1
    }
}

Keep :: (account: *Account) {
    if export_result.count >= EXPORT_LIMIT || (account.issuer[0] == cast(u8)0 && account.name[0] == cast(u8)0) {
        export_result.skipped += 1
        return
    }
    export_accounts[export_result.count] = account.*
    export_result.count += 1
}

// Forgets the accounts read, secrets included.
ClearExport :: () {
    index: s32 = 0
    while index < EXPORT_LIMIT {
        export_accounts[index] = Account.{}
        index += 1
    }
    export_result = ExportResult.{}
}

// "Issuer:alice" names carry the issuer; the account keeps only "alice".
SplitLabel :: (account: *Account) {
    issuer: [64]u8
    rest: [128]u8
    {
        name := TextUntilNul(account.name[:])
        colon: s64 = 0
        while colon < name.count && name[colon] != cast(u8)58 {
            colon += 1
        }
        if colon >= name.count || !CopyLimited(name[0:colon], issuer[:]) {
            return
        }
        start := colon + 1
        while start < name.count && name[start] == cast(u8)32 {
            start += 1
        }
        unused CopyLimited(name[start:name.count], rest[:])
    }
    if account.issuer[0] == cast(u8)0 {
        account.issuer = issuer
    } else if TextUntilNul(issuer[:]) != TextUntilNul(account.issuer[:]) {
        return
    }
    account.name = rest
}

Base64Value :: (byte: u8) -> s32 {
    if byte >= cast(u8)65 && byte <= cast(u8)90 {
        return cast(s32)(byte - cast(u8)65)
    }
    if byte >= cast(u8)97 && byte <= cast(u8)122 {
        return cast(s32)(byte - cast(u8)97) + 26
    }
    if byte >= cast(u8)48 && byte <= cast(u8)57 {
        return cast(s32)(byte - cast(u8)48) + 52
    }
    // A "+" that a link turned into a space, and the URL-safe alphabet.
    if byte == cast(u8)43 || byte == cast(u8)32 || byte == cast(u8)45 {
        return 62
    }
    if byte == cast(u8)47 || byte == cast(u8)95 {
        return 63
    }
    return -1
}

// Decodes Base64 up to its padding. Returns the byte count, or -1.
Base64Decode :: (text: string, output: []u8) -> s32 {
    buffer: u32 = 0
    bits: s32 = 0
    count: s32 = 0
    index: s64 = 0
    while index < text.count && text[index] != cast(u8)61 {
        value := Base64Value(text[index])
        index += 1
        if value < 0 {
            return -1
        }
        buffer = (buffer << cast(u32)6) | cast(u32)value
        bits += 6
        if bits >= 8 {
            bits -= 8
            if count >= cast(s32)output.count {
                return -1
            }
            output[count] = cast(u8)(buffer >> cast(u32)bits)
            count += 1
        }
    }
    return count
}

// A protocol buffer varint; at becomes -1 when the data ends inside it.
Varint :: (data: []u8, end: s32, at: *s32) -> u64 {
    value: u64 = 0
    shift: u64 = 0
    while at.* >= 0 && at.* < end && shift < cast(u64)64 {
        byte := data[at.*]
        at.* += 1
        value = value | (cast(u64)(byte & cast(u8)127) << shift)
        if byte < cast(u8)128 {
            return value
        }
        shift += cast(u64)7
    }
    at.* = -1
    return 0
}

// Moves past one field's value; false when the data is malformed.
SkipField :: (data: []u8, end: s32, at: *s32, wire: u64) -> bool {
    if wire == cast(u64)0 {
        unused Varint(data, end, at)
    } else if wire == cast(u64)1 {
        at.* += 8
    } else if wire == cast(u64)5 {
        at.* += 4
    } else if wire == cast(u64)2 {
        length := Varint(data, end, at)
        if at.* < 0 || length > cast(u64)(end - at.*) {
            return false
        }
        at.* += cast(s32)length
    } else {
        return false
    }
    return at.* >= 0 && at.* <= end
}

// One account of a migration payload (Google's OtpParameters): the secret's
// bytes, name, issuer, algorithm, digits and type.
ReadParameters :: (data: []u8, start: s32, end: s32) {
    account := Account.{.kind = HASH_SHA1, .digits = 6, .period = 30}
    secret_at: s32 = -1
    secret_count: s32 = 0
    readable := true
    at := start
    while readable && at < end {
        key := Varint(data, end, *at)
        if at < 0 {
            readable = false
            break
        }
        field := key >> cast(u64)3
        wire := key & cast(u64)7
        if wire == cast(u64)2 {
            length := Varint(data, end, *at)
            if at < 0 || length > cast(u64)(end - at) {
                readable = false
                break
            }
            value := TextView(data[at:at + cast(s32)length])
            if field == cast(u64)1 {
                secret_at = at
                secret_count = cast(s32)length
            } else if field == cast(u64)2 {
                readable = CopyLimited(value, account.name[:])
            } else if field == cast(u64)3 {
                readable = CopyLimited(value, account.issuer[:])
            }
            at += cast(s32)length
        } else if wire == cast(u64)0 {
            value := Varint(data, end, *at)
            if at < 0 {
                readable = false
                break
            }
            if field == cast(u64)4 {
                // 0 unspecified and 1 SHA-1, 2 SHA-256, 3 SHA-512; 4 is MD5.
                if value == cast(u64)2 {
                    account.kind = HASH_SHA256
                } else if value == cast(u64)3 {
                    account.kind = HASH_SHA512
                } else if value > cast(u64)1 {
                    readable = false
                }
            } else if field == cast(u64)5 {
                // 0 unspecified and 1 six digits, 2 eight.
                if value == cast(u64)2 {
                    account.digits = 8
                } else if value > cast(u64)1 {
                    readable = false
                }
            } else if field == cast(u64)6 {
                // 1 is a counter-based (HOTP) account, 2 time-based.
                readable = value != cast(u64)1
            }
        } else {
            readable = SkipField(data, end, *at, wire)
        }
    }
    secret: [256]u8
    readable = readable && secret_at >= 0 && secret_count <= KEY_LIMIT &&
    Base32Encode(data[secret_at:secret_at + secret_count], secret_count, secret[:]) > 0 &&
    SetSecret(*account, TextUntilNul(secret[:]))
    if readable {
        SplitLabel(*account)
        Keep(*account)
    } else {
        export_result.skipped += 1
    }
    Wipe(secret[:])
    account = Account.{}
}

// otpauth-migration://offline?data=…: Base64 of a MigrationPayload whose
// first field repeats once per account.
ReadMigration :: (link: string) {
    prefix := "otpauth-migration://offline?"
    if !StartsWithIgnoringCase(link, prefix) {
        export_result.skipped += 1
        return
    }
    query := link[prefix.count:link.count]
    data := ""
    position: s64 = 0
    while position < query.count {
        end := position
        while end < query.count && query[end] != cast(u8)38 {
            end += 1
        }
        if StartsWithIgnoringCase(query[position:end], "data=") {
            data = query[position + 5:end]
        }
        position = end + 1
    }
    count: s32 = -1
    if data != "" && Unescape(data, migration_text[:]) {
        count = Base64Decode(TextUntilNul(migration_text[:]), migration_bytes[:])
    }
    if count <= 0 {
        export_result.skipped += 1
    }
    at: s32 = 0
    while count > 0 && at >= 0 && at < count {
        key := Varint(migration_bytes[:], count, *at)
        if at < 0 {
            break
        }
        if key == cast(u64)10 {
            length := Varint(migration_bytes[:], count, *at)
            if at < 0 || length > cast(u64)(count - at) {
                export_result.skipped += 1
                break
            }
            ReadParameters(migration_bytes[:], at, at + cast(s32)length)
            at += cast(s32)length
        } else if !SkipField(migration_bytes[:], count, *at, key & cast(u64)7) {
            break
        }
    }
    Wipe(migration_text[:])
    Wipe(migration_bytes[:])
}

ReadText :: (text: string, at: s32, output: []u8) -> string {
    if at < 0 || ReadStringText(text, at, output) < 0 {
        output[0] = cast(u8)0
    }
    return TextUntilNul(output)
}

// Aegis's export: {"db":{"entries":[{"type":"totp","name":…,"issuer":…,
// "info":{"secret":…,"algo":…,"digits":…,"period":…}}]}}. An encrypted
// Aegis export keeps db as a string; Ente Auth's has encryptedData.
ReadAegis :: (text: string) {
    db := FieldAt(text, 0, "db")
    if (db >= 0 && text[db] == cast(u8)34) || FieldAt(text, 0, "encryptedData") >= 0 {
        export_result.encrypted = true
        return
    }
    entries := FieldAt(text, db, "entries")
    total := ArrayPositions(text, entries, aegis_positions[:])
    if total > EXPORT_LIMIT * 2 {
        total = EXPORT_LIMIT * 2
    }
    index: s32 = 0
    while index < total {
        entry := aegis_positions[index]
        index += 1
        info := FieldAt(text, entry, "info")
        kind: [16]u8
        if ReadText(text, FieldAt(text, entry, "type"), kind[:]) != "totp" || info < 0 {
            export_result.skipped += 1
            continue
        }
        account := Account.{.kind = HASH_SHA1, .digits = 6, .period = 30}
        secret: [256]u8
        readable := SetSecret(*account, ReadText(text, FieldAt(text, info, "secret"), secret[:]))
        algorithm: [16]u8
        if ReadText(text, FieldAt(text, info, "algo"), algorithm[:]) != "" {
            account.kind = ParseAlgorithm(TextUntilNul(algorithm[:]))
            readable = readable && account.kind != 0
        }
        digits := ReadNumber(text, FieldAt(text, info, "digits"))
        if digits.valid {
            account.digits = cast(s32)digits.value
            readable = readable && account.digits >= 6 && account.digits <= 8
        }
        period := ReadNumber(text, FieldAt(text, info, "period"))
        if period.valid {
            account.period = cast(s32)period.value
            readable = readable && account.period >= 1 && account.period <= 300
        }
        issuer: [64]u8
        name: [128]u8
        readable = readable && CopyLimited(ReadText(text, FieldAt(text, entry, "issuer"), issuer[:]), account.issuer[:]) &&
        CopyLimited(ReadText(text, FieldAt(text, entry, "name"), name[:]), account.name[:])
        if readable {
            Keep(*account)
        } else {
            export_result.skipped += 1
        }
        Wipe(secret[:])
        account = Account.{}
    }
}

// Reads every account in an export into export_accounts.
ReadExport :: (text: string) -> ExportResult {
    ClearExport()
    start: s64 = 0
    while start < text.count && text[start] <= cast(u8)32 {
        start += 1
    }
    if start < text.count && text[start] == cast(u8)123 {
        ReadAegis(text[start:text.count])
        return export_result
    }
    while start < text.count {
        while start < text.count && text[start] <= cast(u8)32 {
            start += 1
        }
        end := start
        while end < text.count && text[end] > cast(u8)32 {
            end += 1
        }
        if end > start {
            word := text[start:end]
            if StartsWithIgnoringCase(word, "otpauth-migration://") {
                ReadMigration(word)
            } else {
                account: Account
                if ParseLink(word, *account) {
                    Keep(*account)
                } else {
                    export_result.skipped += 1
                }
                account = Account.{}
            }
        }
        start = end
    }
    return export_result
}
