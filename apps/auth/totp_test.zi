// RFC 6238 and RFC 4648 test vectors, with the RFCs' public fixture keys.
#import "text_buffer"
#import "totp"

KeyFrom :: (text: string, output: []u8) -> s32 {
    index: s64 = 0
    while index < text.count {
        output[index] = text[index]
        index += 1
    }
    return cast(s32)text.count
}

Expect :: (kind: s32, key: string, unix: s64, expected: string) -> bool {
    bytes: [KEY_LIMIT]u8
    count := KeyFrom(key, bytes[:])
    code: [12]u8
    return CodeNow(kind, bytes[:], count, 8, 30, unix, code[:]) == expected
}

#program_export
Run :: () -> s32 {
    sha1 := "12345678901234567890"
    sha256 := "12345678901234567890123456789012"
    sha512 := "1234567890123456789012345678901234567890123456789012345678901234"
    times: [6]s64 = .[59, 1111111109, 1111111111, 1234567890, 2000000000, 20000000000]
    sha1_codes: [6]string = .["94287082", "07081804", "14050471", "89005924", "69279037", "65353130"]
    sha256_codes: [6]string = .["46119246", "68084774", "67062674", "91819424", "90698825", "77737706"]
    sha512_codes: [6]string = .["90693936", "25091201", "99943326", "93441116", "38618901", "47863826"]
    for index: 0..5 {
        if !Expect(HASH_SHA1, sha1, times[index], sha1_codes[index]) {
            return 10 + cast(s32)index
        }
        if !Expect(HASH_SHA256, sha256, times[index], sha256_codes[index]) {
            return 20 + cast(s32)index
        }
        if !Expect(HASH_SHA512, sha512, times[index], sha512_codes[index]) {
            return 30 + cast(s32)index
        }
    }
    decoded: [KEY_LIMIT]u8
    count := Base32Decode("gezd gnbv-gy3t qojq GEZDGNBVGY3TQOJQ====", decoded[:])
    if count != 20 || TextView(decoded[0:20]) != sha1 || Base32Decode("GEZ1", decoded[:]) != -1 {
        return 40
    }
    account: Account
    link := "otpauth://totp/Example%20Co:alice%40example.com?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&issuer=Example%20Co&algorithm=SHA256&digits=8&period=60"
    if !ParseLink(link, *account) || TextUntilNul(account.issuer[:]) != "Example Co" ||
    TextUntilNul(account.name[:]) != "alice@example.com" || account.kind != HASH_SHA256 ||
    account.digits != 8 || account.period != 60 || account.key_count != 20 {
        return 41
    }
    saved: [1024]u8
    again: Account
    if !ParseLink(LinkText(*account, saved[:]), *again) || TextUntilNul(again.secret[:]) != TextUntilNul(account.secret[:]) ||
    TextUntilNul(again.issuer[:]) != "Example Co" || again.digits != 8 || again.period != 60 {
        return 42
    }
    if ParseLink("otpauth://hotp/Example:alice?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&counter=1", *again) ||
    ParseLink("otpauth://totp/Example:alice?secret=SHORT", *again) {
        return 43
    }
    return 0
}
