// Auth: two-factor sign-in codes. Each account is a synced record holding
// its otpauth link, so it follows the owner's Werkzeug account to their
// other devices; secrets are never shown again after adding.
#import "session"
#import "geometry"
#import "text_props"
#import "text_widget"
#import "text_input_props"
#import "text_field_widget"
#import "button_props"
#import "button_widget"
#import "control_props"
#import "box_props"
#import "box_widget"
#import "scroll_props"
#import "scroll_widget"
#import "tree"
#import "text_buffer"
#import "number_text"
#import "werk_app"
#import "app_protocol"
#import "totp"
#import "exports"
Icon :: #import "mingcute_regular_shield";
Edit :: #import "mingcute_regular_edit_2";

ACCOUNT_LIMIT :: 128
LIST_LIMIT :: 65536
// Copied codes clear from the clipboard after this many seconds.
CODE_CLEAR_SECONDS :: 30

VIEW_LIST :: 0
VIEW_ADD :: 1
VIEW_EDIT :: 2

FIELD_LINKS :: 1
FIELD_ISSUER :: 2
FIELD_NAME :: 3
FIELD_SECRET :: 4
FIELD_SITES :: 5

FieldState :: struct {
    cursor: s32
    anchor: s32
    scroll_x: s32
}

CachedCode :: struct {
    step: s64
    code: [12]u8
}

accounts: [ACCOUNT_LIMIT]Account;
codes: [ACCOUNT_LIMIT]CachedCode;
// Each account's record id, and whether its record is written.
record_ids: [ACCOUNT_LIMIT][33]u8;
recorded: [ACCOUNT_LIMIT]bool;
records_version: s32 = -1;
ids: [8192]u8;
account_count: s32;
loaded: bool;
view: s32;
focused: s32;
fields: [6]FieldState;
// A whole export fits: Aegis's JSON is about 250 bytes per account.
links: [65536]u8;
issuer: [64]u8;
name: [128]u8;
secret: [256]u8;
sites: [256]u8;
status: [128]u8;
// The account being edited, and whether its Remove was tapped once; a
// second tap removes it.
editing: s32 = -1;
remove_pending: bool;
list_scroll: s32;
store: [LIST_LIMIT]u8;
session: Session;

SetStatus :: (text: string) {
    unused CopyLimited(text, status[:])
}

Clear :: (bytes: []u8) {
    index: s64 = 0
    while index < bytes.count {
        bytes[index] = cast(u8)0
        index += 1
    }
}

// An account's record id comes from its link, so the same account added on
// two devices is one record. An edited account keeps its id.
SetRecordId :: (index: s32, link: string) {
    unused RecordIdFor(link, record_ids[index][:])
}

// Writes the records of accounts added since the last save.
SaveAccounts :: () -> bool {
    saved := true
    index: s32 = 0
    while index < account_count {
        if !recorded[index] {
            line: [1024]u8
            {
                link := LinkText(*accounts[index], line[:])
                if link != "" {
                    if record_ids[index][0] == cast(u8)0 {
                        SetRecordId(index, link)
                    }
                    recorded[index] = RecordWrite(TextUntilNul(record_ids[index][:]), link)
                }
            }
            Clear(line[:])
            saved = saved && recorded[index]
        }
        index += 1
    }
    return saved
}

LoadAccounts :: () {
    records_version = RecordsVersion()
    // Accounts saved before records existed move into records once.
    count := ReadStore("accounts.txt", store[:])
    if count > 0 {
        account_count = 0
        unused AddExport(TextView(store[0:count]), false)
        if SaveAccounts() {
            unused WriteStore("accounts.txt", "")
        }
    }
    Clear(store[:])
    while account_count > 0 {
        account_count -= 1
        accounts[account_count] = Account.{}
        record_ids[account_count][0] = cast(u8)0
    }
    listed := RecordList(ids[:])
    start: s32 = 0
    at: s32 = 0
    while listed > 0 && at <= listed && account_count < ACCOUNT_LIMIT {
        if at == listed || ids[at] == cast(u8)10 {
            if at > start {
                id := TextView(ids[start:at])
                length := RecordRead(id, store[:])
                account: Account
                if length > 0 && ParseLink(TextView(store[0:length]), *account) {
                    accounts[account_count] = account
                    codes[account_count] = CachedCode.{.step = -1}
                    unused CopyLimited(id, record_ids[account_count][:])
                    recorded[account_count] = true
                    account_count += 1
                }
                account = Account.{}
                Clear(store[0:ifx length > 0 then length else 0])
            }
            start = at + 1
        }
        at += 1
    }
}

// The same secret gives the same codes, whatever the account is called.
SameAccount :: (left: *Account, right: *Account) -> bool {
    return TextUntilNul(left.secret[:]) == TextUntilNul(right.secret[:])
}

// Adds the accounts of an export: otpauth links separated by spaces or line
// breaks, Google Authenticator's export links or Aegis's JSON. Returns how
// many were new.
AddExport :: (text: string, report: bool) -> s32 {
    result := ReadExport(text)
    added: s32 = 0
    refused := result.skipped
    found: s32 = 0
    while found < result.count {
        account := *export_accounts[found]
        known := false
        index: s32 = 0
        while index < account_count {
            if SameAccount(*accounts[index], account) {
                known = true
            }
            index += 1
        }
        if !known && account_count >= ACCOUNT_LIMIT {
            refused += 1
        } else if !known {
            accounts[account_count] = account.*
            codes[account_count] = CachedCode.{.step = -1}
            record_ids[account_count][0] = cast(u8)0
            recorded[account_count] = false
            account_count += 1
            added += 1
        }
        found += 1
    }
    ClearExport()
    if report {
        number: [24]u8
        message: [128]u8
        used := AppendText(message[:], 0, "Added ")
        used = AppendText(message[:], used, FormatInteger(cast(s64)added, number[:]))
        used = AppendText(message[:], used, ifx added == 1 then " account" else " accounts")
        if refused > 0 {
            used = AppendText(message[:], used, ", skipped ")
            used = AppendText(message[:], used, FormatInteger(cast(s64)refused, number[:]))
        }
        if result.encrypted {
            used = AppendText(message[:], 0, "This export is encrypted; export it without a password")
        }
        SetStatus(TextView(message[0:used]))
    }
    return added
}

AddManual :: () -> bool {
    account := Account.{.kind = HASH_SHA1, .digits = 6, .period = 30}
    if name[0] == cast(u8)0 && issuer[0] == cast(u8)0 {
        SetStatus("Enter a name for the account")
        return false
    }
    if !SetSecret(*account, TextUntilNul(secret[:])) {
        SetStatus("The secret key is not valid Base32")
        account = Account.{}
        return false
    }
    account.issuer = issuer
    account.name = name
    if account_count >= ACCOUNT_LIMIT {
        SetStatus("Auth holds at most 128 accounts")
        account = Account.{}
        return false
    }
    accounts[account_count] = account
    codes[account_count] = CachedCode.{.step = -1}
    record_ids[account_count][0] = cast(u8)0
    recorded[account_count] = false
    account_count += 1
    account = Account.{}
    return true
}

// Saves the edited name and websites. The account keeps its record id, so
// the change replaces it on every device.
SaveEdit :: () -> bool {
    account := *accounts[editing]
    if name[0] == cast(u8)0 && issuer[0] == cast(u8)0 {
        SetStatus("Enter a name for the account")
        return false
    }
    websites: [256]u8
    if !NormalizeSites(TextUntilNul(sites[:]), websites[:]) {
        SetStatus("Enter websites such as github.com, separated by spaces")
        return false
    }
    account.issuer = issuer
    account.name = name
    account.sites = websites
    recorded[editing] = false
    if !SaveAccounts() {
        SetStatus("Could not save the account")
        return false
    }
    return true
}

RemoveAccount :: (index: s32) -> bool {
    if recorded[index] && !RecordRemove(TextUntilNul(record_ids[index][:])) {
        return false
    }
    position := index
    while position + 1 < account_count {
        accounts[position] = accounts[position + 1]
        codes[position] = codes[position + 1]
        record_ids[position] = record_ids[position + 1]
        recorded[position] = recorded[position + 1]
        position += 1
    }
    account_count -= 1
    accounts[account_count] = Account.{}
    codes[account_count] = CachedCode.{}
    record_ids[account_count][0] = cast(u8)0
    recorded[account_count] = false
    return true
}

Unix :: () -> s64 {
    return cast(s64)AppNow()
}

// The current code, computed once per time step.
Code :: (index: s32) -> string {
    account := *accounts[index]
    step := Unix() / cast(s64)account.period
    if codes[index].step != step {
        codes[index].step = step
        unused CodeNow(account.kind, account.key[:], account.key_count, account.digits, account.period,
            Unix(), codes[index].code[:])
    }
    return TextUntilNul(codes[index].code[:])
}

Label :: (key: u64, text: string, bounds: Rectangle, font: s32) {
    Text(session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = font,
            .wrap = TextWrap.TextWrapEllipsis})
}

Action :: (id: s32, label: string, bounds: Rectangle, accent: bool) -> bool {
    props := ButtonProps.{.key = cast(u64)id, .id = id, .bounds = bounds, .label = label,
        .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
    if accent {
        props.tone = ButtonTone.ButtonToneAccent
        props.emphasis = ButtonEmphasis.ButtonEmphasisFilled
    }
    return Button(session, props) != 0
}

ApplyEdit :: (buffer: []u8, edit: TextFieldEdit) {
    if !edit.changed {
        return
    }
    length: s64 = 0
    while length < buffer.count && buffer[length] != cast(u8)0 {
        length += 1
    }
    if edit.start < 0 || edit.end < edit.start || cast(s64)edit.end > length {
        return
    }
    used := length - cast(s64)(edit.end - edit.start) + edit.replacement.count
    if used >= buffer.count {
        return
    }
    tail := length - cast(s64)edit.end
    if edit.replacement.count > cast(s64)(edit.end - edit.start) {
        // Move the tail right, from its end.
        index := tail - 1
        while index >= 0 {
            buffer[cast(s64)edit.start + edit.replacement.count + index] = buffer[cast(s64)edit.end + index]
            index -= 1
        }
    } else {
        index: s64 = 0
        while index < tail {
            buffer[cast(s64)edit.start + edit.replacement.count + index] = buffer[cast(s64)edit.end + index]
            index += 1
        }
    }
    index: s64 = 0
    while index < edit.replacement.count {
        buffer[cast(s64)edit.start + index] = edit.replacement[index]
        index += 1
    }
    index = used
    while index < buffer.count {
        buffer[index] = cast(u8)0
        index += 1
    }
}

Field :: (id: s32, label: string, placeholder: string, buffer: []u8, bounds: Rectangle, secure: bool) {
    state := *fields[id]
    edit: TextFieldEdit
    {
        props := TextFieldProps.{.key = cast(u64)(500 + id), .focus_id = 500 + id, .bounds = bounds,
            .label = label, .placeholder = placeholder, .value = TextUntilNul(buffer),
            .cursor = state.cursor, .anchor = state.anchor, .scroll_x = state.scroll_x,
            .focused = focused == id, .max_bytes = cast(s32)buffer.count - 1,
            .max_codepoints = cast(s32)buffer.count - 1, .secure = secure}
        // A secret shows as dots once typed; an empty field shows its hint.
        if secure && buffer[0] != cast(u8)0 {
            props.display_value = "••••••••"
        }
        if focused == id {
            props.input = AppFieldInput()
        }
        result := TextField(session, props)
        state.cursor = result.cursor
        state.anchor = result.anchor
        state.scroll_x = result.scroll_x
        if result.focused {
            focused = id
        } else if focused == id {
            focused = 0
        }
        edit = result.edit
    }
    ApplyEdit(buffer, edit)
}

// Opens an account's name, websites and Remove.
OpenEdit :: (index: s32) {
    account := *accounts[index]
    issuer = account.issuer
    name = account.name
    sites = account.sites
    fields[FIELD_ISSUER] = FieldState.{}
    fields[FIELD_NAME] = FieldState.{}
    fields[FIELD_SITES] = FieldState.{}
    editing = index
    remove_pending = false
    focused = 0
    view = VIEW_EDIT
    SetStatus("")
}

CloseEdit :: () {
    Clear(issuer[:])
    Clear(name[:])
    Clear(sites[:])
    editing = -1
    remove_pending = false
    focused = 0
    view = VIEW_LIST
}

// One account: its name, current code (tap to copy), the seconds left and
// Edit.
DrawRow :: (index: s32, x: float32, y: float32, inner: float32, row: float32) {
    account := *accounts[index]
    Box(session, BoxProps.{.key = cast(u64)(1000 + index), .bounds = Rectangle.{x, y, inner, row - 8.0},
            .radius = 10.0})
    title := TextUntilNul(account.issuer[:])
    subtitle := TextUntilNul(account.name[:])
    if title == "" {
        title = subtitle
        subtitle = ""
    }
    text_width := inner - 210.0
    Label(cast(u64)(2000 + index), title, Rectangle.{x + 12.0, y + 12.0, text_width, 22.0}, 16)
    Label(cast(u64)(3000 + index), subtitle, Rectangle.{x + 12.0, y + 38.0, text_width, 18.0}, 12)
    code := Code(index)
    if Action(4000 + index, code, Rectangle.{x + inner - 196.0, y + 12.0, 140.0, 44.0}, false) {
        if ClipboardCopy(code, CODE_CLEAR_SECONDS) {
            SetStatus("Code copied; it clears in 30 seconds")
        } else {
            SetStatus("The clipboard is unavailable")
        }
    }
    remaining := cast(s64)account.period - Unix() % cast(s64)account.period
    number: [24]u8
    Label(cast(u64)(5000 + index), FormatInteger(remaining, number[:]),
        Rectangle.{x + inner - 52.0, y + 24.0, 16.0, 18.0}, 12)
    edit := ButtonProps.{.key = cast(u64)(6000 + index), .id = 6000 + index, .label = "Edit",
        .bounds = Rectangle.{x + inner - 40.0, y + 16.0, 36.0, 36.0},
        .icon_shape = Edit.Shape, .icon_only = true,
        .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
    if Button(session, edit) != 0 {
        OpenEdit(index)
    }
}

ListView :: (area: Rectangle, left: float32, width: float32) {
    if Action(10, "Add account", Rectangle.{left, area.y + 12.0, width, 40.0}, true) {
        view = VIEW_ADD
        focused = 0
        SetStatus("")
        return
    }
    top := area.y + 64.0
    height := area.height - 100.0
    if account_count == 0 {
        Label(cast(u64)11, "No accounts yet. Add one with its otpauth link or secret key.",
            Rectangle.{left, top, width, 24.0}, 14)
    }
    row: float32 = 76.0
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)12, .bounds = Rectangle.{left, top, width, height},
            .content_height = cast(s32)(cast(float32)account_count * row), .scroll_offset = list_scroll,
            .scale = 1.0})
    list_scroll = scroll.scroll_offset
    if scroll.opened {
        x := scroll.content.x
        inner := scroll.content.width - 10.0
        index: s32 = 0
        while index < account_count && view == VIEW_LIST {
            DrawRow(index, x, scroll.content.y + cast(float32)index * row, inner, row)
            index += 1
        }
        End(session)
    }
}

AddView :: (area: Rectangle, left: float32, width: float32) {
    y := area.y + 12.0
    Label(cast(u64)20, "Paste otpauth links or an authenticator export", Rectangle.{left, y, width, 20.0}, 14)
    Field(FIELD_LINKS, "Links or export", "otpauth://totp/…", links[:], Rectangle.{left, y + 24.0, width, 40.0}, true)
    y += 76.0
    // The desktop can also read an export file or a picture of its QR code.
    files := FileImportAvailable()
    button := ifx files then (width - 8.0) / 2.0 else width
    if Action(21, "Import", Rectangle.{left, y, button, 40.0}, true) {
        ImportLinks()
    }
    if files && Action(25, "Import file", Rectangle.{left + button + 8.0, y, button, 40.0}, false) {
        count := FileImport(links[:])
        if count > 0 {
            ImportLinks()
        } else if count < 0 {
            Clear(links[:])
            SetStatus("That file is not an authenticator export or its QR code")
        }
    }
    y += 64.0
    Label(cast(u64)22, "Or enter the secret key", Rectangle.{left, y, width, 20.0}, 14)
    y += 24.0
    Field(FIELD_ISSUER, "Service", "Service, such as GitHub", issuer[:], Rectangle.{left, y, width, 40.0}, false)
    y += 48.0
    Field(FIELD_NAME, "Account", "Account name or email", name[:], Rectangle.{left, y, width, 40.0}, false)
    y += 48.0
    Field(FIELD_SECRET, "Secret key", "Secret key", secret[:], Rectangle.{left, y, width, 40.0}, true)
    y += 56.0
    half := (width - 8.0) / 2.0
    if Action(23, "Add", Rectangle.{left, y, half, 40.0}, true) {
        if AddManual() {
            if SaveAccounts() {
                SetStatus("Account added")
            } else {
                SetStatus("Could not save the accounts")
            }
            Clear(issuer[:])
            Clear(name[:])
            Clear(secret[:])
            view = VIEW_LIST
        }
    }
    if Action(24, "Cancel", Rectangle.{left + half + 8.0, y, half, 40.0}, false) {
        Clear(links[:])
        Clear(secret[:])
        view = VIEW_LIST
        SetStatus("")
    }
}

// Adds the accounts in the links field, then forgets the field.
ImportLinks :: () {
    added := AddExport(TextUntilNul(links[:]), true)
    if added > 0 && !SaveAccounts() {
        SetStatus("Could not save the accounts")
    }
    Clear(links[:])
    fields[FIELD_LINKS] = FieldState.{}
    if added > 0 {
        view = VIEW_LIST
    }
}

EditView :: (area: Rectangle, left: float32, width: float32) {
    y := area.y + 12.0
    Field(FIELD_ISSUER, "Service", "Service, such as GitHub", issuer[:], Rectangle.{left, y, width, 40.0}, false)
    y += 48.0
    Field(FIELD_NAME, "Account", "Account name or email", name[:], Rectangle.{left, y, width, 40.0}, false)
    y += 56.0
    Label(cast(u64)40, "Websites where it signs in, such as github.com", Rectangle.{left, y, width, 20.0}, 14)
    y += 24.0
    Field(FIELD_SITES, "Websites", "github.com", sites[:], Rectangle.{left, y, width, 40.0}, false)
    y += 56.0
    half := (width - 8.0) / 2.0
    if Action(41, "Save", Rectangle.{left, y, half, 40.0}, true) {
        if SaveEdit() {
            CloseEdit()
            SetStatus("Account saved")
        }
        return
    }
    if Action(42, "Cancel", Rectangle.{left + half + 8.0, y, half, 40.0}, false) {
        CloseEdit()
        SetStatus("")
        return
    }
    y += 64.0
    remove := ButtonProps.{.key = cast(u64)43, .id = 43, .bounds = Rectangle.{left, y, width, 40.0},
        .label = ifx remove_pending then "Tap again to remove" else "Remove account",
        .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
    if remove_pending {
        remove.tone = ButtonTone.ButtonToneDanger
        remove.emphasis = ButtonEmphasis.ButtonEmphasisFilled
    }
    if Button(session, remove) == 0 {
        return
    }
    if !remove_pending {
        remove_pending = true
        SetStatus("Tap the red button again to remove this account")
        return
    }
    removed := RemoveAccount(editing)
    CloseEdit()
    SetStatus(ifx removed then "Account removed" else "Could not remove the account")
}

Draw :: () {
    session = AppSession()
    area := AppBounds()
    width := area.width - 32.0
    if width > 520.0 {
        width = 520.0
    }
    left := area.x + (area.width - width) * 0.5
    if view == VIEW_ADD {
        AddView(area, left, width)
    } else if view == VIEW_EDIT && editing >= 0 && editing < account_count {
        EditView(area, left, width)
    } else {
        ListView(area, left, width)
    }
    Label(cast(u64)30, TextUntilNul(status[:]), Rectangle.{left, area.y + area.height - 28.0, width, 20.0}, 12)
    AppKeyboard(focused != 0)
}

#program_export "AuthMain"
Main :: () -> s32 {
    if AppMode() == APP_IDENTIFY {
        AppDescribe("Auth", Icon.Shape)
        return APP_PROTOCOL
    }
    // Records from another device replace the list, and close an edit.
    if !loaded || RecordsVersion() != records_version {
        LoadAccounts()
        loaded = true
        if view == VIEW_EDIT {
            CloseEdit()
        }
    }
    Draw()
    return 0
}
