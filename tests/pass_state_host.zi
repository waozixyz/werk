#program_export
AppBoundsHost :: () -> Rectangle { return Rectangle.{} }
#program_export
AppDarkHost :: () -> bool { return false }
#program_export
AppKeyHost :: () -> s32 { return 0 }
#program_export
AppModifiersHost :: () -> s32 { return 0 }
#program_export
AppFieldInputHost :: () -> TextFieldInput { return TextFieldInput.{} }
#program_export
AppKeyboardHost :: (visible: bool) {}
#program_export
AppNowHost :: () -> float64 { return 0.0 }
#program_export
AppLocalOffsetHost :: () -> s32 { return 0 }
#program_export
AppAssetPathHost :: (name: string) -> string { return "" }
#program_export
AppPbkdf2Sha256Host :: (password: string, salt: string, iterations: s32) -> string { return "" }

// Pass keeps no synced records.
#program_export
RecordListHost :: (output: []u8) -> s32 {
    return -1
}
#program_export
RecordReadHost :: (id: string, output: []u8) -> s32 {
    return -1
}
#program_export
RecordWriteHost :: (id: string, value: string) -> bool {
    return false
}
#program_export
RecordRemoveHost :: (id: string) -> bool {
    return false
}
#program_export
RecordsVersionHost :: () -> s32 {
    return 0
}
