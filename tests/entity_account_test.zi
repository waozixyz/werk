PictureEntity :: #import "entity/model";
PictureShared :: #import "entity/native_files";

libc :: #system_library "libc";
RemoveDirectory :: (path: *u8) -> s32 #foreign libc "rmdir";

// Account fixtures have no renderer. Image extraction and rendering run in
// the private GUI suite; an unavailable image is the real headless contract.
#program_export
ImageWidth :: (path: string) -> s32 { unused path; return 0 }
#program_export
ImageHeight :: (path: string) -> s32 { unused path; return 0 }

#program_export
Check :: () -> s32 {
    mode := EnvironmentText("WERK_TEST_JOURNAL_MODE")
    if mode == "hold" { return HoldJournal() }
    if mode == "recover" { return RecoverJournal() }
    LoadProfile()
    LoadAccount()
    unused CopyCString("http://127.0.0.1:9", profile.node[:])
    if !SaveProfile() || !CreateAccount() || !SetAccountSyncEnabled(false) { return 1 }
    if !RecordPut("auth", "fixture", "fixture-secret-only", 100) ||
    !RecordPut("auth", "removed", "fixture-removed", 101) || !RecordDelete("auth", "removed", 102) { return 2 }
    original: Recovery
    defer { RecoveryClear(*original) }
    if !WerkRecoveryLoad(null, *original) { return 3 }
    vault: [32]u8
    for index: 0..31 { vault[index] = account.vault[index] }
    same: Recovery
    same.keys = original.keys
    defer { RecoveryClear(*same) }
    if WerkRecoveryApply(null, *same, 0) != 1 || !account.paused || record_table.count != 2 { return 4 }
    for index: 0..31 { if account.vault[index] != vault[index] { return 5 } }
    if record_table.records[0].updated != 100 || record_table.records[1].updated != 102 || !record_table.records[1].deleted { return 6 }
    incoming: Recovery
    defer { RecoveryClear(*incoming) }
    if CreateAccountKeys(*incoming.keys) == 0 { return 7 }
    if WerkRecoveryApply(null, *incoming, 0) != 2 || AccountId() != TextUntilNul(original.keys.public_id[:]) || record_table.count != 2 { return 8 }
    // An unwritable journal target must leave the existing key and data intact.
    obstruction: [PATH_LIMIT]u8
    obstruction_path := JournalPath("keys.txt", obstruction[:])
    if !CreatePrivateDirectory(obstruction_path) || WerkRecoveryApply(null, *incoming, 1) != 0 ||
    AccountId() != TextUntilNul(original.keys.public_id[:]) || record_table.count != 2 { return 9 }
    if RemoveDirectory(*obstruction[0]) != 0 { return 10 }
    if WerkRecoveryApply(null, *incoming, 1) != 1 || !account.paused || record_table.count != 2 ||
    TextUntilNul(record_table.records[0].value[:]) != "fixture-secret-only" || !record_table.records[1].deleted { return 11 }
    if !record_table.records[0].dirty || !record_table.records[1].dirty || record_table.records[0].updated != 100 { return 12 }
    if WerkRecoveryApply(null, *original, 2) != 1 || record_table.count != 0 || !account.paused { return 13 }
    for index: 0..31 { if account.vault[index] != vault[index] { return 14 } }
    if !RecordPut("auth", "restored", "fixture-recovered", 222) || !JournalBegin() { return 15 }
    key_path: [PATH_LIMIT]u8
    if !WritePrivate(JournalAccountPath(key_path[:]), "incomplete replacement") { return 16 }
    record_table.count = 0
    if !RecordsSave() || !JournalRecover() { return 17 }
    LoadAccount()
    record_table.loaded = false
    if !AccountReady() || AccountId() != TextUntilNul(original.keys.public_id[:]) || !RecordsOpen("auth") ||
    record_table.count != 1 || TextUntilNul(record_table.records[0].value[:]) != "fixture-recovered" || record_table.records[0].updated != 222 { return 18 }
    if !ForgetAccount() || AccountReady() || record_table.count != 1 { return 19 }
    pictures := CheckPictures()
    if pictures != 0 { return pictures }
    return CheckPictureReadback()
}

// Werkzeug keeps an abstract picture chosen in Entity's page, publishes it
// in the same numbers as every app, and unpacks all of Entity's pictures.
CheckPictures :: () -> s32 {
    profile.picture = 4
    profile.picture_kind = 1
    profile.abstract_picture = 2
    if ProfileIcon() != 129 || !SaveProfile() { return 20 }
    LoadProfile()
    if profile.picture_kind != 1 || profile.abstract_picture != 2 || profile.picture != 4 || ProfileIcon() != 129 { return 21 }
    profile.picture_kind = 0
    if ProfileIcon() != 45 { return 22 }
    profile.picture_chosen = false
    if !ProfileAdoptPicture(128, 45) || ProfileIcon() != 128 || profile.picture_kind != 1 ||
    profile.abstract_picture != 1 || profile.picture_published != 128 { return 25 }
    if !SaveProfile() { return 26 }
    LoadProfile()
    if ProfileIcon() != 128 { return 27 }
    // A valid remote picture, an invalid node icon and a pending local choice.
    profile.picture_chosen = true
    if ProfileAdoptPicture(45, 41) || ProfileIcon() != 128 { return 28 }
    if ProfileAdoptPicture(0, 128) || ProfileAdoptPicture(130, 128) { return 29 }
    if !ProfileAdoptPicture(45, 128) || ProfileIcon() != 45 || profile.picture_kind != 0 { return 30 }
    if !EntityPictureAsset("entity", "assets/entity/abstract-jade.webp") ||
    !EntityPictureAsset("entity", "assets/entity/pfp.webp") { return 23 }
    if EntityPictureAsset("pass", "assets/entity/pfp.webp") || EntityPictureAsset("entity", "assets/entity/") ||
    EntityPictureAsset("entity", "assets/entity/../key") || EntityPictureAsset("entity", "assets/pfp.png") { return 24 }
    // Readback must update the shared picture without replacing preferences
    // another app saved in the same account's public profile.
    owner := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    shared := PictureEntity.EntityDefault()
    unused CopyCString(owner, shared.owner_id[:])
    unused CopyCString("Shared name", shared.name[:])
    unused CopyCString("Shared intention", shared.intention[:])
    unused CopyCString("https://node.example.org", shared.nodes[0][:])
    shared = PictureEntity.EntityWithPublicIcon(shared, 45)
    if !PictureShared.SharedProfileSave(owner, shared) { return 31 }
    profile.picture_chosen = false
    if !ProfileReceivePicture(128, 45, owner) || ProfileIcon() != 128 { return 32 }
    LoadProfile()
    restored := PictureEntity.EntityDefault()
    if ProfileIcon() != 128 || TextUntilNul(profile.picture_owner[:]) != owner ||
    !PictureShared.SharedProfileLoad(owner, *restored) || PictureEntity.EntityPublicIcon(restored) != 128 ||
    TextUntilNul(restored.name[:]) != "Shared name" || TextUntilNul(restored.intention[:]) != "Shared intention" ||
    TextUntilNul(restored.nodes[0][:]) != "https://node.example.org" { return 33 }
    profile.picture_chosen = true
    if ProfileReceivePicture(45, 41, owner) || ProfileIcon() != 128 { return 34 }
    if !PictureShared.SharedProfileLoad(owner, *restored) || PictureEntity.EntityPublicIcon(restored) != 128 { return 35 }
    return 0
}


ProbeSleep :: (microseconds: u32) -> s32 #foreign libc "usleep";

// The normal background pump must fetch a remote choice without opening
// Entity, and a previously saved shared profile must not shadow that choice.
CheckPictureReadback :: () -> s32 {
    server := EnvironmentText("WERK_TEST_PICTURE_SERVER")
    if server == "" || !CopyCString(server, profile.node[:]) || !SaveProfile() ||
    !CreateAccount() || !SetAccountSyncEnabled(true) { return 36 }
    profile.picture_chosen = false
    profile.picture_published = 45
    profile.picture_kind = 0
    profile.picture = 4
    profile.picture_owner = account.keys.public_id
    if !SaveProfile() { return 37 }
    shared := PictureEntity.EntityDefault()
    shared.owner_id = account.keys.public_id
    unused CopyCString("Other app's name", shared.name[:])
    shared = PictureEntity.EntityWithPublicIcon(shared, 45)
    if !PictureShared.SharedProfileSave(AccountId(), shared) { return 38 }
    // Exercise the same pump as WerkFrame, without opening Entity or
    // explicitly starting its management provider.
    if werk_management_started { return 42 }
    for attempt: 0..299 {
        WerkManagementPump()
        if ProfileIcon() == 128 { break }
        unused ProbeSleep(10000)
    }
    restored := PictureEntity.EntityDefault()
    if ProfileIcon() != 128 || TextUntilNul(profile.picture_owner[:]) != AccountId() ||
    !PictureShared.SharedProfileLoad(AccountId(), *restored) || PictureEntity.EntityPublicIcon(restored) != 128 ||
    TextUntilNul(restored.name[:]) != "Other app's name" { return 39 }
    LoadProfile()
    if ProfileIcon() != 128 { return 40 }
    EntityPictureReadStop(*werk_picture_reader)
    return ifx ForgetAccount() then 0 else 41
}

#program_export
HoldJournal :: () -> s32 {
    if !JournalAcquire() { return 1 }
    defer { JournalRelease() }
    if !JournalBegin() { return 2 }
    ready: [PATH_LIMIT]u8
    if !WritePrivate(JournalPath("held", ready[:]), "fixture") { return 3 }
    unused ProbeSleep(2000000)
    return ifx JournalCommit() then 0 else 4
}

#program_export
RecoverJournal :: () -> s32 { return ifx JournalRecover() then 0 else 1 }
