// Where Werkzeug keeps its files, and the clock, clipboard, keyboard and
// secret storage its apps use, on the desktop and on Android. Every file
// Werkzeug writes is private (0600 in 0700 folders).
#import "std/file"
#import "std/date_time_linux"
#import "std/date_parse"
#import "std/c_string"
#import "std/byte_text_linux"
#import "std/text_buffer"
#import "std/timer_linux"
using UI :: #import "kryon/Widgets";
#import "kryon/SystemTheme"
#import "files"

#if #defined(ANDROID_BUILD) {
    #import "android"
    #import "android_jni"
    #import "android_input"
    raylib_files :: #system_library "raylib";
    LoadFileData :: (name: *u8, size: *s32) -> *u8 #foreign raylib_files "LoadFileData";
} else #if #defined(PLATFORM_WEB) {
    #import "browser_storage"
} else {
    LinuxTheme :: #import "kryon/SystemThemeLinux";
}

libc :: #system_library "libc";
Environment :: (name: *u8) -> *u8 #foreign libc "getenv";
ExecutableLink :: (path: *u8, output: *u8, limit: usize) -> isize #foreign libc "readlink";

data_root: [PATH_LIMIT]u8;
cache_root: [PATH_LIMIT]u8;
bundled_apps: [PATH_LIMIT]u8;
assets_root: [PATH_LIMIT]u8;
pictures_path: [PATH_LIMIT]u8;

EnvironmentText :: (name: string) -> string {
    key: [64]u8
    if !CopyCString(name, key[:]) {
        return ""
    }
    value := Environment(*key[0])
    if value == null {
        return ""
    }
    return TextFromCString(value)
}

// $XDG_<kind>_HOME/werk, or ~/<fallback>/werk.
UserRoot :: (output: []u8, variable: string, fallback: string) -> string {
    base := EnvironmentText(variable)
    folder: [PATH_LIMIT]u8
    if base == "" {
        home := EnvironmentText("HOME")
        if home == "" {
            return ""
        }
        base = PathJoin(folder[:], home, fallback)
    }
    return PathJoin(output, base, "werk")
}

// Werkzeug's private data. On Android it is the app's internal folder,
// where Pass kept its files.
#program_export
DataRoot :: () -> string {
    if data_root[0] == cast(u8)0 {
        #if #defined(ANDROID_BUILD) {
            internal := ActivityInternalDataPath()
            if internal != null {
                unused CopyCString(TextFromCString(internal), data_root[:])
            }
        } else #if #defined(PLATFORM_WEB) {
            unused CopyCString(BROWSER_DATA, data_root[:])
        } else {
            override := EnvironmentText("WERK_DATA")
            if override != "" {
                unused CopyCString(override, data_root[:])
            } else {
                unused UserRoot(data_root[:], "XDG_DATA_HOME", ".local/share")
            }
        }
    }
    return TextUntilNul(data_root[:])
}

#program_export
CacheRoot :: () -> string {
    if cache_root[0] == cast(u8)0 {
        #if #defined(ANDROID_BUILD) {
            unused PathJoin(cache_root[:], DataRoot(), "cache")
        } else #if #defined(PLATFORM_WEB) {
            unused CopyCString("/tmp/werk-cache", cache_root[:])
        } else {
            unused UserRoot(cache_root[:], "XDG_CACHE_HOME", ".cache")
        }
    }
    return TextUntilNul(cache_root[:])
}

// Werkzeug's own files: lib/werk beside an installed executable's
// prefix, ~/.local/lib/werk for a user installation, or the folder of
// the executable in a build. WERK_ASSETS overrides them. On Android
// they are the APK's assets, read by relative path; the browser build
// embeds them at the root of its file system.
#program_export
AssetsRoot :: () -> string {
    #if #defined(ANDROID_BUILD) || #defined(PLATFORM_WEB) {
        return ""
    }
    if assets_root[0] != cast(u8)0 {
        return TextUntilNul(assets_root[:])
    }
    override := EnvironmentText("WERK_ASSETS")
    if override != "" {
        unused CopyCString(override, assets_root[:])
        return TextUntilNul(assets_root[:])
    }
    link: [32]u8
    executable: [PATH_LIMIT]u8
    unused CopyCString("/proc/self/exe", link[:])
    count := ExecutableLink(*link[0], *executable[0], cast(usize)(PATH_LIMIT - 1))
    if count <= 0 {
        return ""
    }
    folder := cast(s64)count
    while folder > 0 && executable[folder - 1] != cast(u8)47 {
        folder -= 1
    }
    base := TextView(executable[0:folder - 1])
    installed: [PATH_LIMIT]u8
    user: [PATH_LIMIT]u8
    candidates: [3]string = .[base, PathJoin(installed[:], base, "../lib/werk"),
    PathJoin(user[:], EnvironmentText("HOME"), ".local/lib/werk")]
    for index: 0..2 {
        apps: [PATH_LIMIT]u8
        if candidates[index] != "" && DirectoryExists(PathJoin(apps[:], candidates[index], "apps")) {
            unused CopyCString(candidates[index], assets_root[:])
            return TextUntilNul(assets_root[:])
        }
    }
    unused CopyCString(base, assets_root[:])
    return TextUntilNul(assets_root[:])
}

// The path of one of Werkzeug's own files.
AssetPath :: (output: []u8, name: string) -> string {
    #if #defined(ANDROID_BUILD) {
        unused CopyCString(name, output)
        return TextUntilNul(output)
    }
    return PathJoin(output, AssetsRoot(), name)
}

#program_export
BundledAppsRoot :: () -> string {
    return AssetPath(bundled_apps[:], "apps")
}

ProfilePicturesPath :: () -> string {
    return AssetPath(pictures_path[:], "pfp.png")
}

// A preinstalled app bundle's bytes, which stay loaded while it runs.
ReadBundle :: (path: string) -> (bytes: string, found: bool) {
    #if #defined(ANDROID_BUILD) {
        name: [PATH_LIMIT]u8
        size: s32 = 0
        if !CopyCString(path, name[:]) {
            return "", false
        }
        data := LoadFileData(*name[0], *size)
        if data == null || size <= 0 {
            return "", false
        }
        return TextFromBytes(BytesFromPointer(data, cast(u64)size)), true
    } else {
        bytes, found := ReadEntireFile(path)
        return bytes, found
    }
}

system_dark: bool;
system_dark_read_at: float64 = -10.0;

// Whether the device prefers dark colors, read at most every five seconds.
SystemDark :: () -> bool {
    now := SteadyClock()
    if now - system_dark_read_at > 5.0 {
        #if #defined(ANDROID_BUILD) {
            system_dark = AndroidDark()
        } else #if #defined(PLATFORM_WEB) {
            system_dark = BrowserDark()
        } else {
            system_dark = LinuxTheme.SystemPaletteRead().dark
        }
        system_dark_read_at = now
    }
    return system_dark
}

// Seconds since the Unix epoch.
#program_export
WallClock :: () -> float64 {
    return cast(float64)UnixMilliseconds() / 1000.0
}

// Seconds the local time zone is ahead of UTC now.
#program_export
LocalOffset :: () -> s32 {
    now := UnixNow()
    local := LocalAt(now)
    if !local.valid {
        return 0
    }
    seconds := DaysFromCivil(local.year, local.month, local.day) * 86400 +
    cast(s64)(local.hour * 3600 + local.minute * 60 + local.second)
    return cast(s32)(seconds - now)
}

// A steady clock for timers; it never jumps with the wall clock.
#program_export
SteadyClock :: () -> float64 {
    return cast(float64)MonotonicMilliseconds() / 1000.0
}

SetClipboard :: (value: string) -> bool {
    #if #defined(ANDROID_BUILD) {
        return AndroidClipboardWrite(value)
    } else {
        return SystemClipboardSet(value)
    }
}

ClipboardText :: (output: []u8) -> string {
    #if #defined(ANDROID_BUILD) {
        return AndroidClipboardRead(output)
    } else {
        return SystemClipboardText(output)
    }
}

// Copied text and when to clear it again.
clipboard_value: [4096]u8;
clipboard_clear_at: float64;

#program_export
ClipboardPut :: (value: string, clear_seconds: s32) -> bool {
    if value.count >= 4096 || !SetClipboard(value) {
        return false
    }
    unused CopyCString(value, clipboard_value[:])
    clipboard_clear_at = 0.0
    if clear_seconds > 0 && value != "" {
        clipboard_clear_at = SteadyClock() + cast(float64)clear_seconds
    }
    return true
}

// Clears copied text when its time is up, unless another application has
// replaced it since.
#program_export
ClipboardTick :: () {
    if clipboard_clear_at <= 0.0 || SteadyClock() < clipboard_clear_at {
        return
    }
    clipboard_clear_at = 0.0
    current: [4096]u8
    if ClipboardText(current[:]) == TextUntilNul(clipboard_value[:]) {
        unused SetClipboard("")
    }
    for index: 0..4095 {
        clipboard_value[index] = cast(u8)0
    }
}

// Shows or hides the touch keyboard; the desktop has none.
ShowKeyboard :: (visible: bool) {
    #if #defined(ANDROID_BUILD) {
        AndroidKeyboard(visible)
        if !visible {
            AndroidTextHide()
        }
    }
}

// One secret kept behind the device's own authentication: Android's
// keystore. The desktop has none.
SecureAvailable :: () -> bool {
    #if #defined(ANDROID_BUILD) {
        return AndroidSecureAvailable()
    } else {
        return false
    }
}

SecureSaved :: () -> bool {
    #if #defined(ANDROID_BUILD) {
        return AndroidSecureSaved()
    } else {
        return false
    }
}

SecureRequest :: (secret: string, save: bool) -> bool {
    #if #defined(ANDROID_BUILD) {
        return AndroidSecureRequest(secret, save)
    } else {
        return false
    }
}

SecureForget :: () -> bool {
    #if #defined(ANDROID_BUILD) {
        return AndroidSecureForget()
    } else {
        return true
    }
}

SecurePoll :: (output: []u8) -> s32 {
    #if #defined(ANDROID_BUILD) {
        return AndroidSecurePoll(output)
    } else {
        return 0
    }
}
