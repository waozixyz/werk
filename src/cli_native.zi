#import "text"
#import "std/c_string"
#import "std/text_buffer"
#import "std/byte_text_linux"
Capture :: #import "std/process_capture_linux";
Channel :: #import "std/process_channel_linux";
Socket :: #import "std/socket_linux";
Timer :: #import "std/timer_linux";

libc :: #system_library "libc";
NativeRead :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "read";
NativeWrite :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "write";
NativeOpen :: (path: *u8, flags: s32) -> s32 #foreign libc "open";
NativeClose :: (fd: s32) -> s32 #foreign libc "close";
NativeEnv :: (name: *u8) -> *u8 #foreign libc "getenv";
NativeIsTty :: (fd: s32) -> s32 #foreign libc "isatty";
NativeGetTerminal :: (fd: s32, state: *void) -> s32 #foreign libc "tcgetattr";
NativeSetTerminal :: (fd: s32, action: s32, state: *void) -> s32 #foreign libc "tcsetattr";
NativeSession :: () -> s32 #foreign libc "setsid";
NativeShutdown :: (fd: s32, direction: s32) -> s32 #foreign libc "shutdown";
NativePipe :: (fds: *s32) -> s32 #foreign libc "pipe";
NativeFork :: () -> s32 #foreign libc "fork";
NativeDup :: (source: s32, destination: s32) -> s32 #foreign libc "dup2";
NativeExit :: (code: s32) -> void #foreign libc "_exit";
NativeWait :: (pid: s32, status: *s32, options: s32) -> s32 #foreign libc "waitpid";
SignalHandler :: #type (signal: s32) #c_call;
NativeSignal :: (signal: s32, handler: SignalHandler) -> SignalHandler #foreign libc "signal";

terminal_fd: s32 = -1;
terminal_state: [32]u64;

RestoreTerminalOnSignal :: (signal: s32) {
    if terminal_fd >= 0 { unused NativeSetTerminal(terminal_fd, 0, cast(*void)*terminal_state[0]) }
    NativeExit(128 + signal)
}

EnvironmentText :: (name: string) -> string {
    bytes: [128]u8
    if !CopyCString(name, bytes[:]) { return "" }
    value := NativeEnv(*bytes[0])
    if value == null { return "" }
    return TextFromCString(value)
}

ExpandHomePath :: (value: string, output: []u8) -> bool {
    if value == "~" || (value.count >= 2 && value[0:2] == "~/") {
        home := EnvironmentText("HOME")
        if home == "" { return false }
        return AppendText(output, AppendText(output, 0, home), value[1:]) >= 0
    }
    return CopyCString(value, output)
}

// 0 means no file; -1 is an unreadable, oversized or invalid configuration.
ReadProfileDocument :: (output: []u8) -> s32 {
    path: [4096]u8
    base := EnvironmentText("XDG_CONFIG_HOME")
    if base != "" { if !CopyCString(base, path[:]) { return -1 } }
    else if !ExpandHomePath("~/.config", path[:]) { return 0 }
    if AppendText(path[:], cast(s32)TextUntilNul(path[:]).count, "/pass/profiles.json") < 0 { return -1 }
    fd := NativeOpen(*path[0], 0)
    if fd < 0 { if Socket.LinuxErrno() == 2 { return 0 }; return -1 }
    defer { unused NativeClose(fd) }
    used: s32
    while used < cast(s32)output.count - 1 {
        count := NativeRead(fd, *output[used], cast(usize)(cast(s32)output.count - 1 - used))
        if count < cast(isize)0 { return -1 }
        if count == cast(isize)0 { output[used] = cast(u8)0; return used + 1 }
        used += cast(s32)count
    }
    return -1
}

ReadSecret :: (buffer: []u8, prompt: string) -> bool {
    fd: s32 = 0
    terminal := NativeIsTty(fd) == 1
    previous: [4]SignalHandler
    signals: [4]s32 = .[1, 2, 3, 15]
    if terminal {
        if NativeGetTerminal(fd, cast(*void)*terminal_state[0]) != 0 { return false }
        terminal_fd = fd
        for i: 0..3 { previous[i] = NativeSignal(signals[i], RestoreTerminalOnSignal) }
    }
    defer {
        if terminal {
            unused NativeSetTerminal(fd, 0, cast(*void)*terminal_state[0])
            terminal_fd = -1
            restored: s32 = 0
            while restored < 4 {
                unused NativeSignal(signals[restored], previous[restored]); restored += 1
            }
            newline: [1]u8 = .[cast(u8)10]
            unused NativeWrite(2, *newline[0], cast(usize)1)
        }
    }
    if terminal {
        // stty owns the platform-specific termios layout. The opaque saved
        // state is restored even when input is cancelled with Ctrl-C.
        ignored: [128]u8
        args: [8]string = .["stty", "-echo", "-isig", "-icanon", "min", "1", "time", "0"]
        changed := Capture.CaptureOutput(args[:], ignored[:])
        if changed.error || changed.code != 0 { return false }
        message: [128]u8
        if CopyCString(prompt, message[:]) { unused NativeWrite(2, *message[0], cast(usize)prompt.count) }
    }
    used: s32
    while used < cast(s32)buffer.count - 1 {
        byte: u8
        if NativeRead(fd, *byte, cast(usize)1) != cast(isize)1 { return used > 0 }
        if byte == cast(u8)0 || byte == cast(u8)3 || byte == cast(u8)4 { return false }
        if terminal && (byte == cast(u8)8 || byte == cast(u8)127) {
            if used > 0 { used -= 1; buffer[used] = cast(u8)0 }
            continue
        }
        if terminal && byte == cast(u8)21 { ClearBytes(buffer); used = 0; continue }
        if byte == cast(u8)10 {
            if used > 0 && buffer[used - 1] == cast(u8)13 { used -= 1 }
            buffer[used] = cast(u8)0; return true
        }
        buffer[used] = byte; used += 1
    }
    return false
}

DecryptVault :: (vault: string, output: []u8) -> bool {
    path: [4096]u8
    if !ExpandHomePath(vault, path[:]) { return false }
    passphrase: [1024]u8
    defer { ClearBytes(passphrase[:]) }
    if !ReadSecret(passphrase[:], "Vault passphrase: ") { return false }
    args: [16]string = .["openssl", "enc", "-d", "-aes-256-cbc", "-md", "sha512", "-a", "-A", "-pbkdf2", "-iter", "100000", "-in", TextUntilNul(path[:]), "-pass", "stdin", "-salt"]
    child := Channel.StartChannel(args[:], false)
    if child.error != 0 { return false }
    defer { unused Channel.CloseChannel(*child, 1000) }
    length := cast(s32)TextUntilNul(passphrase[:]).count
    passphrase[length] = cast(u8)10
    if Channel.ChannelSend(child, passphrase[0:length + 1], 3000) < 0 { return false }
    unused NativeShutdown(child.socket.fd, 1)
    used: s32
    while used < cast(s32)output.count - 1 {
        count := Channel.ChannelReceive(child, output[used:cast(s32)output.count - 1], 10000)
        if count < 0 { return false }
        if count == 0 { break }
        used += cast(s32)count
    }
    if used >= cast(s32)output.count - 1 || !Channel.WaitChannel(*child, 1000) || child.code != 0 { return false }
    while used > 0 && output[used - 1] == cast(u8)10 { used -= 1 }
    for i: 0..used - 1 { if output[i] == cast(u8)0 { return false } }
    output[used] = cast(u8)0
    return true
}

// A detached supervisor retains only its own clipboard child. Expiration
// releases that selection; it never clears a replacement owner's clipboard.
CopyPassword :: (value: string, clear_ms: s64) -> bool {
    if EnvironmentText("DISPLAY") == "" { return false }
    ready: [2]s32
    if NativePipe(*ready[0]) != 0 { return false }
    pid := NativeFork()
    if pid < 0 { unused NativeClose(ready[0]); unused NativeClose(ready[1]); return false }
    if pid == 0 {
        unused NativeClose(ready[0]); unused NativeSession()
        null_path: [16]u8; CopyCString("/dev/null", null_path[:])
        null_fd := NativeOpen(*null_path[0], 2)
        if null_fd >= 0 {
            for i: 0..2 { unused NativeDup(null_fd, cast(s32)i) }
            if null_fd > 2 { unused NativeClose(null_fd) }
        }
        args: [5]string = .["xclip", "-selection", "clipboard", "-in", "-quiet"]
        child := Channel.StartChannel(args[:], false)
        ok := child.error == 0
        if ok {
            payload: [36]u8
            ok = CopyCString(value, payload[:])
            if ok { ok = Channel.ChannelSend(child, payload[0:value.count], 3000) >= 0 }
            ClearBytes(payload[:])
            unused NativeShutdown(child.socket.fd, 1)
            if Channel.WaitChannel(*child, 100) { ok = false }
        }
        answer: u8 = ifx ok then cast(u8)1 else cast(u8)0
        unused NativeWrite(ready[1], *answer, cast(usize)1)
        unused NativeClose(ready[1])
        if ok {
            started := Timer.MonotonicMilliseconds()
            while !Channel.WaitChannel(*child, 100) {
                if child.error != 0 || (clear_ms > 0 && Timer.MonotonicMilliseconds() - started >= clear_ms) { break }
            }
        }
        unused Channel.CloseChannel(*child, 0)
        NativeExit(0)
    }
    unused NativeClose(ready[1])
    answer: u8
    ok := NativeRead(ready[0], *answer, cast(usize)1) == cast(isize)1 && answer == cast(u8)1
    unused NativeClose(ready[0])
    if !ok { status: s32; unused NativeWait(pid, *status, 0) }
    return ok
}
