Json :: #import "std/json_scan";
#import "pass_core"
#import "text"
#import "cli_native"
#import "std/text_buffer"

LegacyProfile :: struct {
    found: bool
    valid: bool
    login: [1024]u8
    vault: [4096]u8
    exclude: [1024]u8
    copy: bool
    clear_ms: s64
}

profile_document: [65536]u8;

ProfileString :: (document: string, object: s32, name: string, output: []u8) -> bool {
    at := Json.FieldAt(document, object, name)
    if at < 0 || Json.MatchLiteral(document, at, "null") { return true }
    return Json.ReadStringText(document, at, output) >= 0
}

ProfileBool :: (document: string, object: s32, name: string, value: *bool) -> bool {
    at := Json.FieldAt(document, object, name)
    if at < 0 || Json.MatchLiteral(document, at, "null") { return true }
    if Json.MatchLiteral(document, at, "true") { <<value = true; return true }
    if Json.MatchLiteral(document, at, "false") { <<value = false; return true }
    return false
}

// The original CLI accepted Go-style durations; keep seconds, minutes, hours
// and fractional/composite values without placing any secrets in a command.
DurationMilliseconds :: (value: string) -> s64 {
    if value == "0" { return 0 }
    at: s32; total: float64
    while at < cast(s32)value.count {
        number := Json.ReadNumber(value, at)
        if !number.valid || number.value < 0 { return -1 }
        at = number.after
        scale: float64
        if at + 2 <= cast(s32)value.count && value[at:at + 2] == "ms" { scale = 1; at += 2 }
        else if at < cast(s32)value.count && value[at] == cast(u8)115 { scale = 1000; at += 1 }
        else if at < cast(s32)value.count && value[at] == cast(u8)109 { scale = 60000; at += 1 }
        else if at < cast(s32)value.count && value[at] == cast(u8)104 { scale = 3600000; at += 1 }
        else { return -1 }
        total += number.value * scale
        if total > 2147483647 { return -1 }
    }
    if at == 0 { return -1 }
    return cast(s64)total
}

ProfileDefaults :: (document: string, object: s32, result: *LegacyProfile) -> bool {
    if !ProfileString(document, object, "vault", result.vault[:]) ||
    !ProfileBool(document, object, "copy", *result.copy) { return false }
    duration: [128]u8
    if !ProfileString(document, object, "clear_after", duration[:]) { return false }
    if duration[0] != cast(u8)0 {
        result.clear_ms = DurationMilliseconds(TextUntilNul(duration[:]))
        if result.clear_ms < 0 { return false }
    }
    return true
}

LoadLegacyProfile :: (name: string, required: bool, options: *PassOptions,
    explicit: u32) -> LegacyProfile {
    result: LegacyProfile
    loaded := ReadProfileDocument(profile_document[:])
    if loaded < 0 { return result }
    if loaded == 0 { result.valid = !required; return result }
    document := TextUntilNul(profile_document[:])
    start := Json.Space(document, 0)
    end := Json.ValueEnd(document, start, 0)
    if start >= cast(s32)document.count || document[start] != cast(u8)123 ||
    end < 0 || Json.Space(document, end) != cast(s32)document.count { return result }
    if !ProfileDefaults(document, start, *result) { return result }
    profiles := Json.FieldAt(document, start, "profiles")
    profile := Json.FieldAt(document, profiles, name)
    if name == "" || profile < 0 { result.valid = !required; return result }
    if document[profile] != cast(u8)123 ||
    !ProfileString(document, profile, "login", result.login[:]) ||
    result.login[0] == cast(u8)0 || !ProfileDefaults(document, profile, *result) { return result }
    names: [2]string = .["length", "counter"]
    for i: 0..1 {
        at := Json.FieldAt(document, profile, names[i])
        if at >= 0 && !Json.MatchLiteral(document, at, "null") {
            after := Json.ValueEnd(document, at, 0)
            number := ParseNumber(document[at:after])
            if !number.valid || number.value < 0 { return result }
            if i == 0 && number.value > 2147483647 { return result }
            if number.value > 0 && (explicit & (cast(u32)1 << i)) == cast(u32)0 {
                if i == 0 { options.length = cast(s32)number.value }
                else { options.counter = cast(u64)number.value }
            }
        }
    }
    if (explicit & cast(u32)4) == cast(u32)0 && !ProfileBool(document, profile, "lowercase", *options.lowercase) { return result }
    if (explicit & cast(u32)8) == cast(u32)0 && !ProfileBool(document, profile, "uppercase", *options.uppercase) { return result }
    if (explicit & cast(u32)16) == cast(u32)0 && !ProfileBool(document, profile, "digits", *options.digits) { return result }
    if (explicit & cast(u32)32) == cast(u32)0 && !ProfileBool(document, profile, "symbols", *options.symbols) { return result }
    if !ProfileString(document, profile, "exclude", result.exclude[:]) { return result }
    result.found = true; result.valid = true
    return result
}
