// Kryon owns NativeActivity lifecycle, touch input and software presentation.
#import "kryon/android_run"
#import "kryon/session"
#import "kryon/android_jni"
#import "kryon/geometry"
#import "kryon/android_device"
#import "kryon/android_surface"
#import "werk"
#import "apps"
#import "android"
#import "android_input"
#import "android_fields"
#import "android_glue"

android_started: bool;
android_configuration :: #system_library "android";
ConfigurationDensity :: (configuration: *void) -> s32 #foreign android_configuration "AConfiguration_getDensity";

// Werkzeug's framework editor owns soft-input visibility for its fields.
#program_export
SetPlatformTextKeyboardVisible :: (session: Session, visible: bool) {
    unused session
    AndroidKeyboard(visible || WerkKeyboard())
}

#program_export "ProjectFrame"
WerkAndroidFrame :: (session: Session, viewport: Rectangle) -> s32 {
    if !android_started {
        if !AndroidInitialize() || !AndroidTextInitialize() { return 1 }
        SetAndroidViewportPolicy(AndroidViewportPolicyResizeForIme())
        app := JniGetAndroidApp()
        if app != null && app.configuration != null {
            density := ConfigurationDensity(app.configuration)
            if density > 0 && density < 65534 {
                AndroidNativeSetDensity(null, null, cast(float32)density / 160.0)
            }
        }
        WerkStart()
        android_started = true
    }
    PollAndroidWindowInsets()
    AndroidFieldsBegin()
    status := WerkFrame(session, viewport)
    AndroidFieldsEnd()
    AndroidKeyboard(WerkKeyboard())
    return status
}

#program_export
main :: () -> s32 { return AndroidRunMain() }

// Retain the existing save-on-exit behavior around Kryon's lifecycle owner.
android_entry :: #system_library "android_entry";
AndroidMain :: (app: *NativeAndroidApp) #foreign android_entry "__real_android_main";
#program_export "__wrap_android_main"
WerkAndroidMain :: (app: *NativeAndroidApp) {
    AndroidMain(app)
    if android_started { unused SaveApps() }
}
