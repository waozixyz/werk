#import "werk"
#import "std/c_string"
#import "std/byte_text_linux"
Command :: #import "command";
Desktop :: #import "kryon/Desktop";
using UI :: #import "kryon/Widgets";
#import "kryon/Frame"

sdl :: #system_library "SDL2";
SetTitle :: (window: *void, title: *u8) #foreign sdl "SDL_SetWindowTitle";
libc :: #system_library "libc";
WriteError :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "write";

DESKTOP_WIDTH :: 420
DESKTOP_HEIGHT :: 760

Report :: (message: string) {
    buffer: [256]u8
    if CopyCString(message, buffer[:]) {
        unused WriteError(2, *buffer[0], cast(usize)message.count)
    }
}

DrawDesktop :: (session: Session) -> bool {
    Desktop.BeginDesktopFrame()
    // After BeginDesktopFrame, which applies a resize from the last frame.
    viewport := Desktop.DesktopViewport()
    pointer := Desktop.PollPointer()
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, Desktop.PollSecondaryPointer())
    PointerWheelSend(session, pointer.x, pointer.y, Desktop.DesktopWheelMove())
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk {
        Report("Werkzeug: could not begin frame\n")
        return false
    }
    if WerkFrame(session, viewport) != 0 {
        TreeCancel(session)
        Report("Werkzeug: could not compose frame\n")
        return false
    }
    if EndFrame(session) != FrameStatus.FrameOk {
        Report("Werkzeug: could not paint frame\n")
        return false
    }
    unused Desktop.DesktopCursor(session)
    ok := Desktop.EndDesktopFrame()
    if !ok {
        Report("Werkzeug: could not present frame\n")
    }
    return ok
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    // `werk sync …` and `werk auth …` run without a window.
    if argc >= 2 {
        group := TextFromCString(argv[1])
        if group == "sync" || group == "auth" {
            return Command.RunCommand(argc, argv)
        }
    }
    if !Desktop.OpenDesktopSized(DESKTOP_WIDTH, DESKTOP_HEIGHT) {
        Desktop.CloseDesktop()
        Report("Werkzeug: could not open desktop\n")
        return 1
    }
    title: [16]u8
    unused CopyCString("Werkzeug", title[:])
    SetTitle(Desktop.window, *title[0])
    session := SessionOpen()
    if !SessionValid(session) {
        Desktop.CloseDesktop()
        return 1
    }
    WerkStart()
    // `werk --app auth` opens one tool first, as Harmony's Auth entry does.
    if argc >= 3 && TextFromCString(argv[1]) == "--app" {
        unused WerkOpen(TextFromCString(argv[2]), false)
    }
    ok: bool = true
    if Desktop.CaptureRequested() {
        ok = DrawDesktop(session)
        if ok {
            ok = Desktop.CaptureConfigured()
        }
    } else {
        while ok && Desktop.PollDesktop() {
            KeyboardModifiersSend(session, Desktop.DesktopModifiers())
            key := Desktop.DesktopPressedKey()
            if key != 0 {
                KeyboardSend(session, key)
            }
            codepoint := Desktop.DesktopTypedCodepoint()
            while codepoint != 0 {
                TypedCodepointSend(session, codepoint)
                codepoint = Desktop.DesktopTypedCodepoint()
            }
            ok = DrawDesktop(session)
            if ok {
                Desktop.PauseDesktop()
            }
        }
    }
    CloseSession(session)
    Desktop.CloseDesktop()
    if ok {
        return 0
    }
    return 1
}
