// Browser storage: Werkzeug's files live in IndexedDB through Emscripten's
// IDBFS, in the same /pass-data database Pass used, so Pass's saved
// profiles and settings carry over. Without storage (private windows,
// embedded previews) the tools still work; nothing is kept.
#import "web"
#import "std/byte_text_linux"

BROWSER_DATA :: "/pass-data"

sync_done: bool;
sync_failed: bool;
browser_persistent: bool;
shared_waiting: bool;
shared_done: bool;

SharedProfileAttached :: (context: s32, value: s32, second: s32, third: s32) {
    if shared_waiting { shared_done = true }
}

SharedProfileLoaded :: (context: s32, event: s32, second: s32, third: s32) {
    if !shared_waiting { return }
    scope := WebScope()
    shared := WebGetObject(WebGlobal, WebName("WaoziAccount"))
    promise := WebAsObject(WebCall2(shared, WebName("attach"), WebObject(WebModule), WebNumber(5000.0)))
    callback := WebFunction(SharedProfileAttached, 0)
    unused WebCall2(promise, WebName("then"), WebObject(callback), WebObject(callback))
    WebEnd(scope)
}

// Load the common browser identity before local display preferences. The
// tools remain usable from their offline cache when the hub is unavailable.
BrowserShareOpen :: () {
    scope := WebScope()
    document := WebGetObject(WebGlobal, WebName("document"))
    script := WebAsObject(WebCall1(document, WebName("createElement"), WebText("script")))
    loaded := WebFunction(SharedProfileLoaded, 0)
    failed := WebFunction(SharedProfileAttached, 0)
    shared_waiting = true
    shared_done = false
    WebSet(script, WebName("src"), WebText("https://account.waozi.xyz/share.js"))
    WebSet(script, WebName("onload"), WebObject(loaded))
    WebSet(script, WebName("onerror"), WebObject(failed))
    unused WebCall1(WebGetObject(document, WebName("head")), WebName("appendChild"), WebObject(script))
    // Performance.now is available before the canvas opens.
    performance := WebGetObject(WebGlobal, WebName("performance"))
    started := WebAsNumber(WebCall0(performance, WebName("now")))
    while !shared_done && WebAsNumber(WebCall0(performance, WebName("now"))) - started < 8000.0 { WebSleep(10) }
    shared_waiting = false
    WebEnd(scope)
}

StorageSynced :: (context: s32, error: s32, second: s32, third: s32) {
    sync_failed = !WebIsUndefined(WebValueOf(error))
    sync_done = true
}

// Copies IndexedDB into memory (populate) or memory into IndexedDB.
BrowserSync :: (populate: bool) -> bool {
    scope := WebScope()
    fs := WebGetObject(WebModule, WebName("FS"))
    callback := WebFunction(StorageSynced, 0)
    sync_done = false
    sync_failed = false
    WebCall2(fs, WebName("syncfs"), WebBool(populate), WebObject(callback))
    ok := !WebFailed()
    while ok && !sync_done {
        WebSleep(1)
    }
    WebRelease(callback)
    WebEnd(scope)
    return ok && !sync_failed
}

// Mounts the data folder and registers the offline worker.
BrowserStorageOpen :: () -> bool {
    scope := WebScope()
    fs := WebGetObject(WebModule, WebName("FS"))
    backend := WebGetObject(WebModule, WebName("IDBFS"))
    WebCall1(fs, WebName("mkdir"), WebText(BROWSER_DATA))
    if WebFailed() {
        WebEnd(scope)
        return false
    }
    options := WebNewObject()
    arguments: [3]WebValue = .[WebObject(backend), WebObject(options), WebText(BROWSER_DATA)]
    WebCall(fs, WebName("mount"), *arguments[0], 3)
    mounted := !WebFailed()
    WebEnd(scope)
    scope = WebScope()
    navigator := WebGetObject(WebGlobal, WebName("navigator"))
    worker := WebGetObject(navigator, WebName("serviceWorker"))
    if worker != 0 {
        WebCall1(worker, WebName("register"), WebText("sw.js"))
    }
    WebEnd(scope)
    browser_persistent = mounted && BrowserSync(true)
    scope = WebScope()
    WebSet(WebModule, WebName("sharedAccountMounted"), WebBool(browser_persistent))
    WebEnd(scope)
    return true
}

// Saves written files to IndexedDB; false when the browser keeps nothing.
BrowserStorageSave :: () -> bool {
    return browser_persistent && BrowserSync(false)
}

// Download only bytes the host has already read from the app's own folder.
BrowserDownload :: (name: string, bytes: string) -> bool {
    scope := WebScope()
    defer WebEnd(scope)
    descriptor := cast(*TextDescriptor)(*bytes)
    data := WebBytes(WebBytesUint8, cast(*void)descriptor.data, cast(s32)bytes.count)
    parts := WebNewArray()
    unused WebCall1(parts, WebName("push"), WebObject(data))
    blob := WebNew1(WebGetObject(WebGlobal, WebName("Blob")), WebObject(parts))
    urls := WebGetObject(WebGlobal, WebName("URL"))
    url := WebCall1(urls, WebName("createObjectURL"), WebObject(blob))
    document := WebGetObject(WebGlobal, WebName("document"))
    anchor := WebAsObject(WebCall1(document, WebName("createElement"), WebText("a")))
    WebSet(anchor, WebName("href"), url)
    WebSet(anchor, WebName("download"), WebText(name))
    unused WebCall0(anchor, WebName("click"))
    ok := !WebFailed()
    unused WebCall1(urls, WebName("revokeObjectURL"), url)
    return ok
}

BrowserDark :: () -> bool {
    scope := WebScope()
    media := WebAsObject(WebCall1(WebGlobal, WebName("matchMedia"), WebText("(prefers-color-scheme: dark)")))
    dark := WebAsBool(WebGet(media, WebName("matches")))
    WebEnd(scope)
    return dark
}

page_text: [4096]u8;

// The page address's query, such as "?app=pass".
BrowserQuery :: () -> string {
    page_text[0] = cast(u8)0
    scope := WebScope()
    location := WebGetObject(WebGlobal, WebName("location"))
    if location != 0 && !WebFailed() {
        value := WebGet(location, WebName("search"))
        if value.tag == WebStringTag {
            WebCopyString(WebAsObject(value), page_text[:])
        }
    }
    WebEnd(scope)
    index: s32 = 0
    while index < 4095 && page_text[index] != cast(u8)0 {
        index += 1
    }
    return TextView(page_text[0:index])
}

BrowserSharedProfile :: (output: []u8) -> string {
    scope := WebScope()
    defer WebEnd(scope)
    value := WebGet(WebModule, WebName("sharedProfileDocument"))
    if value.tag != WebStringTag { return "" }
    length := WebCopyString(WebAsObject(value), output)
    if length <= 0 || length >= cast(s32)output.count { return "" }
    return TextView(output[:length])
}

BrowserSharedReady :: () -> bool {
    scope := WebScope()
    defer WebEnd(scope)
    return WebAsBool(WebGet(WebModule, WebName("sharedAccountReady"))) &&
    WebAsBool(WebGet(WebModule, WebName("sharedAccountInitialized")))
}

BrowserOpenProfile :: () {
    unused BrowserStorageSave()
    scope := WebScope()
    location := WebGetObject(WebGlobal, WebName("location"))
    unused WebCall1(location, WebName("assign"), WebText("https://entity.waozi.xyz/"))
    WebEnd(scope)
}
