// Runs the Werkzeug apps. Each app is its own bundle: the host checks every
// capability it asks for, answers its calls and draws its widgets into the
// host's session. An app's files, assets and secret belong to it alone.
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "std/text_buffer"
#import "std/vec"
#import "std/number_text"
#import "std/c_string"
#import "std/file"
#import "kryon/hosted_app"
#import "kryon/hosted_values"
#import "kryon/widget_codec"
#import "kryon/widget_host"
using UI :: #import "kryon/Widgets";
#import "kryon/app_protocol"
#import "kryon/app_context_host"
#import "kryon/app_local"
#import "kryon/app_files"
#import "kryon/key_input"
#import "platform"
#import "files"
#import "sha256"
#import "records"
#import "entity_host"
#import "entity_management"
#if !#defined(PLATFORM_WEB) {
    #import "sync"
}
#if !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB) {
    #import "file_import"
}
#if #defined(ANDROID_BUILD) {
    #import "android_fields"
}

#if #defined(PLATFORM_DESKTOP) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
    Spreadsheet :: #import "workbook/service";
    Font :: #import "kryon/font_metrics";
    Picker :: #import "kryon/file_picker";
    Json :: #import "std/json_scan";
}
using HostValueKind;

APP_LIMIT :: 8
APP_STORE_LIMIT :: 262144
// The preinstalled apps, in their home screen order.
BUNDLED_APPS :: 4

App :: struct {
    id: [128]u8
    name: [64]u8
    icon: [16384]u8
    asset_folder: [PATH_LIMIT]u8
    // The bundle's bytes stay alive while it is open.
    bytes: string
    portable: AppContext
    local: AppLocal
    document_root: [PATH_LIMIT]u8
    bundled: bool
    started: bool
    #if #defined(PLATFORM_DESKTOP) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
        spreadsheet: Spreadsheet.Context
    }
}

// What the running app sees this frame.
AppView :: struct {
    session: Session
    bounds: Rectangle
    dark: bool
    key: s32
    modifiers: s32
    input: TextFieldInput
}

apps: [APP_LIMIT]App;
app_count: s32;
entity_index: s32 = -1;
app_keyboard: bool;
// The app whose call the host is answering, for the asset policy.
running: s32 = -1;
// Text returned to an app stays here until its run returns.
answer_text: [PATH_LIMIT]u8;
store_bytes: [APP_STORE_LIMIT]u8;

AppId :: (index: s32) -> string {
    return TextUntilNul(apps[index].id[:])
}

AppName :: (index: s32) -> string {
    return TextUntilNul(apps[index].name[:])
}

AppIcon :: (index: s32) -> string {
    return TextUntilNul(apps[index].icon[:])
}

AppCount :: () -> s32 {
    return app_count
}

// Each service is granted to the app that owns it. New app bundles never
// receive Pass's device secret simply because another app can use it.
AppServiceAllowed :: (context: *void, name: string) -> bool {
    app := cast(*App)context
    id := TextUntilNul(app.id[:])
    #if #defined(PLATFORM_DESKTOP) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
        if name == "spreadsheet.v1" { return app.bundled && id == "workbook" }
        if name == "input.v1" || name == "document.pick.v1" || name == "app.bundle.export.v1" { return true }
    }
    if name == "entity.assets" || name == "entity.management" { return id == "entity" }
    if name == "media.asset" || name == "media.query" || name == "media.pick" {
        return AppLocalAllows(cast(*void)(*app.local), name)
    }
    if name == "SecureAvailableHost" || name == "SecureSavedHost" ||
    name == "SecureRequestHost" || name == "SecureForgetHost" || name == "SecurePollHost" ||
    name == "AppPbkdf2Sha256Host" {
        return app.bundled && id == "pass"
    }
    if name == "RecordListHost" || name == "RecordReadHost" || name == "RecordWriteHost" ||
    name == "RecordRemoveHost" || name == "RecordsVersionHost" ||
    name == "FileImportAvailableHost" || name == "FileImportHost" {
        return app.bundled && id == "auth"
    }
    return name == "DocumentReadHost" || name == "DocumentWriteHost" ||
    name == "DocumentStatusHost" || name == "AppLocaleHost" ||
    name == "AppNowHost" || name == "AppLocalOffsetHost" ||
    name == "AppAssetPathHost" || name == "ReadStoreHost" || name == "WriteStoreHost" ||
    name == "ClipboardCopyHost"
}

ArgumentText :: (value: HostValue) -> string {
    if value.kind != cast(s32)HostString || value.length == cast(usize)0 || value.data == null {
        return ""
    }
    return TextFromBytes(BytesFromPointer(value.data, cast(u64)value.length))
}

ReturnText :: (result: *HostValue, text: string) {
    unused CopyCString(text, answer_text[:])
    result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
        .data = *answer_text[0], .length = cast(usize)TextUntilNul(answer_text[:]).count}
}

ReturnBytes :: (result: *HostValue, bytes: []u8) {
    count := bytes.count
    if count > answer_text.count {
        count = 0
    }
    index: s64 = 0
    while index < count {
        answer_text[index] = bytes[index]
        index += 1
    }
    result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
        .data = *answer_text[0], .length = cast(usize)count}
}

// Forgets text and keys handed to an app once its run has copied them.
ForgetAnswer :: () {
    for index: 0..PATH_LIMIT - 1 {
        answer_text[index] = cast(u8)0
    }
}

ReturnVoid :: (result: *HostValue) {
    result.* = HostValue.{.kind = cast(s32)HostVoid, .type_name = HostTextData("void")}
}

ReturnBool :: (result: *HostValue, value: bool) {
    result.* = HostScalar("bool", ifx value then 1 else 0)
}

ReturnReal :: (result: *HostValue, value: float64) {
    result.* = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float64"), .real = value}
}

CopyField :: (output: []u8, value: string) {
    count := value.count
    if count >= output.count {
        count = output.count - 1
    }
    index: s64 = 0
    while index < count {
        output[index] = value[index]
        index += 1
    }
    output[count] = cast(u8)0
}

// The app's own folder of files, created on first use.
StorePath :: (app: *App, name: string, output: []u8) -> string {
    if !SafeName(name) {
        return ""
    }
    apps_folder: [PATH_LIMIT]u8
    own: [PATH_LIMIT]u8
    folder := PathJoin(own[:], PathJoin(apps_folder[:], DataRoot(), "apps"), TextUntilNul(app.id[:]))
    if folder == "" || !EnsureDirectory(folder) {
        return ""
    }
    return PathJoin(output, folder, name)
}

ReadStoreCall :: (app: *App, arguments: *HostValue, result: *HostValue) -> s32 {
    output := arguments[1]
    if output.kind != cast(s32)HostSlice || (output.length > cast(usize)0 && output.elements == null) {
        return 0
    }
    path_bytes: [PATH_LIMIT]u8
    path := StorePath(app, ArgumentText(arguments[0]), path_bytes[:])
    count: s32 = -1
    limit := cast(s64)output.length
    if limit > APP_STORE_LIMIT {
        limit = APP_STORE_LIMIT
    }
    if path != "" && limit >= 2 {
        count = ReadPrivate(path, store_bytes[0:limit])
    }
    // The app reads a terminated text, as from a C buffer.
    index: s64 = 0
    while count >= 0 && index <= cast(s64)count && index < cast(s64)output.length {
        output.elements[index].bits = cast(u64)store_bytes[index]
        output.elements[index].integer = cast(s64)store_bytes[index]
        index += 1
    }
    result.* = HostScalar("s32", cast(s64)count)
    return 1
}

// Text of count bytes and its NUL into the app's buffer, as from C.
ReturnBytes :: (output: HostValue, bytes: []u8, count: s32, result: *HostValue) -> s32 {
    if output.kind != cast(s32)HostSlice || (output.length > cast(usize)0 && output.elements == null) {
        return 0
    }
    index: s64 = 0
    while count >= 0 && index <= cast(s64)count && index < cast(s64)output.length && index < bytes.count {
        output.elements[index].bits = cast(u64)bytes[index]
        output.elements[index].integer = cast(s64)bytes[index]
        index += 1
    }
    result.* = HostScalar("s32", cast(s64)count)
    return 1
}

RecordCall :: (app: *App, name: string, arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    app_id := TextUntilNul(app.id[:])
    now := cast(s64)(WallClock() * 1000.0)
    if name == "RecordListHost" && count == 1 {
        limit := cast(s64)arguments[0].length
        used := RecordIds(app_id, store_bytes[0:ifx limit > APP_STORE_LIMIT then APP_STORE_LIMIT else limit])
        return ReturnBytes(arguments[0], store_bytes[:], used, result)
    }
    if name == "RecordReadHost" && count == 2 {
        limit := cast(s64)arguments[1].length
        used := RecordValue(app_id, ArgumentText(arguments[0]),
            store_bytes[0:ifx limit > APP_STORE_LIMIT then APP_STORE_LIMIT else limit])
        return ReturnBytes(arguments[1], store_bytes[:], used, result)
    }
    if name == "RecordWriteHost" && count == 2 {
        saved := RecordPut(app_id, ArgumentText(arguments[0]), ArgumentText(arguments[1]), now)
        #if !#defined(PLATFORM_WEB) {
            if saved {
                SyncSoon()
            }
        }
        ReturnBool(result, saved)
        return 1
    }
    if name == "RecordRemoveHost" && count == 1 {
        removed := RecordDelete(app_id, ArgumentText(arguments[0]), now)
        #if !#defined(PLATFORM_WEB) {
            if removed {
                SyncSoon()
            }
        }
        ReturnBool(result, removed)
        return 1
    }
    if name == "RecordsVersionHost" {
        result.* = HostScalar("s32", cast(s64)RecordsVersion(app_id))
        return 1
    }
    return 0
}

// A secret the device unlocked is copied into the app's buffer, then wiped.
SecurePollCall :: (arguments: *HostValue, result: *HostValue) -> s32 {
    output := arguments[0]
    if output.kind != cast(s32)HostSlice || (output.length > cast(usize)0 && output.elements == null) {
        return 0
    }
    secret: [1024]u8
    status := SecurePoll(secret[:])
    index: s64 = 0
    while status == 2 && index < cast(s64)output.length && index < 1024 {
        output.elements[index].bits = cast(u64)secret[index]
        output.elements[index].integer = cast(s64)secret[index]
        index += 1
    }
    for wipe: 0..1023 {
        secret[wipe] = cast(u8)0
    }
    result.* = HostScalar("s32", cast(s64)status)
    return 1
}

AppCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    app := cast(*App)context
    name := TextFromCString(function)
    if TextUntilNul(app.id[:]) == "entity" && name == "AppServiceHost" && count == 2 && ArgumentText(arguments[0]) == "entity.assets" {
        ReturnText(result, TextUntilNul(app.asset_folder[:]))
        return 1
    }
    if TextUntilNul(app.id[:]) == "entity" && name == "AppServiceHost" && count == 2 && ArgumentText(arguments[0]) == "entity.management" {
        request := ArgumentText(arguments[1])
        if request == "" {
            document := WerkManagementRead()
            result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
                .data = HostTextData(document), .length = cast(usize)document.count}
        } else { ReturnText(result, ifx WerkManagementEnqueue(request) then "queued" else "rejected") }
        return 1
    }
    if TextUntilNul(app.id[:]) == "entity" && name == "ReadStoreHost" && count == 2 && ArgumentText(arguments[0]) == "entity.json" {
        text := WerkEntityRead()
        output := arguments[1]
        used := cast(s32)text.count
        if output.kind != cast(s32)HostSlice || output.elements == null || cast(usize)(used + 1) > output.length { return 0 }
        for index: 0..used {
            byte := ifx index < used then text[index] else cast(u8)0
            output.elements[index].bits = cast(u64)byte
            output.elements[index].integer = cast(s64)byte
        }
        result.* = HostScalar("s32", used)
        return 1
    }
    if TextUntilNul(app.id[:]) == "entity" && name == "WriteStoreHost" && count == 2 && ArgumentText(arguments[0]) == "entity.json" {
        ReturnBool(result, WerkEntityWrite(ArgumentText(arguments[1])))
        return 1
    }
    if name == "AppServiceHost" || name == "AppLocaleHost" || name == "DocumentReadHost" ||
    name == "DocumentWriteHost" || name == "DocumentStatusHost" {
        if name != "AppLocaleHost" && !app.local.files.lock.valid {
            path: [PATH_LIMIT]u8
            root := StorePath(app, "documents", path[:])
            CopyField(app.document_root[:], root)
            if !AppFilesOpen(*app.local.files, TextUntilNul(app.document_root[:])) {
                return 0
            }
        }
        #if #defined(PLATFORM_DESKTOP) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
            if name == "AppServiceHost" && count == 2 {
                service := ArgumentText(arguments[0])
                request := ArgumentText(arguments[1])
                if service == "spreadsheet.v1" {
                    text := Spreadsheet.Call(*app.spreadsheet, *app.local.files, request)
                    result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"), .data = HostTextData(text), .length = cast(usize)text.count}
                    return 1
                }
                if service == "app.bundle.export.v1" { ReturnText(result, ExportBundle(app)); return 1 }
                if service == "input.v1" { InputCall(app, request, result); return 1 }
                if service == "document.pick.v1" { ReturnText(result, DocumentPick(app, request)); return 1 }
            }
        }
        return AppLocalCall(cast(*void)(*app.local), module, function, arguments, count, result)
    }
    if name == "ReadStoreHost" && count == 2 {
        return ReadStoreCall(app, arguments, result)
    }
    if name.count > 6 && name[0:6] == "Record" {
        return RecordCall(app, name, arguments, count, result)
    }
    if name == "WriteStoreHost" && count == 2 {
        path_bytes: [PATH_LIMIT]u8
        path := StorePath(app, ArgumentText(arguments[0]), path_bytes[:])
        ReturnBool(result, path != "" && WritePrivate(path, ArgumentText(arguments[1])))
        return 1
    }
    if name == "AppPbkdf2Sha256Host" && count == 3 {
        iterations := arguments[2].integer
        if iterations < 1 || iterations > 1000000 {
            ReturnText(result, "")
            return 1
        }
        derived := Pbkdf2Sha256(ArgumentText(arguments[0]), ArgumentText(arguments[1]), cast(s32)iterations)
        ReturnBytes(result, derived[:])
        for index: 0..31 {
            derived[index] = cast(u8)0
        }
        return 1
    }
    if name == "AppNowHost" {
        ReturnReal(result, WallClock())
        return 1
    }
    if name == "AppLocalOffsetHost" {
        result.* = HostScalar("s32", cast(s64)LocalOffset())
        return 1
    }
    if name == "ClipboardCopyHost" && count == 2 {
        ReturnBool(result, ClipboardPut(ArgumentText(arguments[0]), cast(s32)arguments[1].integer))
        return 1
    }
    if name == "AppAssetPathHost" && count == 1 {
        asset := ArgumentText(arguments[0])
        path: [PATH_LIMIT]u8
        found := SafeName(asset) && app.asset_folder[0] != cast(u8)0
        if found {
            found = PathExists(PathJoin(path[:], TextUntilNul(app.asset_folder[:]), asset))
        }
        ReturnText(result, ifx found then TextUntilNul(path[:]) else "")
        return 1
    }
    if name == "FileImportAvailableHost" {
        #if !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB) {
            ReturnBool(result, ImportFileAvailable())
        } else {
            ReturnBool(result, false)
        }
        return 1
    }
    if name == "FileImportHost" && count == 1 {
        limit := cast(s64)arguments[0].length
        used: s32 = -1
        #if !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB) {
            used = ImportFile(store_bytes[0:ifx limit > APP_STORE_LIMIT then APP_STORE_LIMIT else limit])
        }
        returned := ReturnBytes(arguments[0], store_bytes[:], used, result)
        // The export holds two-factor secrets; nothing keeps a copy.
        index: s32 = 0
        while index < used {
            store_bytes[index] = cast(u8)0
            index += 1
        }
        return returned
    }
    if name == "SecureAvailableHost" {
        ReturnBool(result, SecureAvailable())
        return 1
    }
    if name == "SecureSavedHost" {
        ReturnBool(result, SecureSaved())
        return 1
    }
    if name == "SecureRequestHost" && count == 2 {
        ReturnBool(result, SecureRequest(ArgumentText(arguments[0]), arguments[1].integer != 0))
        return 1
    }
    if name == "SecureForgetHost" {
        ReturnBool(result, SecureForget())
        return 1
    }
    if name == "SecurePollHost" && count == 1 {
        return SecurePollCall(arguments, result)
    }
    return 0
}

// Images an app draws come from its own unpacked assets.
AssetAllowed :: (path: string) -> bool {
    // Widgets without an image ask with an empty path.
    if path == "" {
        return true
    }
    if running < 0 {
        return false
    }
    documents := TextUntilNul(apps[running].document_root[:])
    if documents != "" && path.count > documents.count + 1 &&
    path[:documents.count] == documents && path[documents.count] == cast(u8)47 {
        return AppFileNameValid(path[documents.count + 1:])
    }
    folder := TextUntilNul(apps[running].asset_folder[:])
    return folder != "" && path.count > folder.count + 1 && path[0:folder.count] == folder &&
    path[folder.count] == cast(u8)47
}

// Unpacks the bundle's assets/ files into the app's cache folder, so the
// renderer can read them by path.
UnpackAssets :: (app: *App) {
    root: [PATH_LIMIT]u8
    own: [PATH_LIMIT]u8
    app.asset_folder[0] = cast(u8)0
    folder := PathJoin(own[:], PathJoin(root[:], CacheRoot(), "apps"), TextUntilNul(app.id[:]))
    if folder == "" || !EnsureDirectory(folder) {
        return
    }
    CopyField(app.asset_folder[:], folder)
    bundle := app.portable.app.bundle
    count := BundleAssets(bundle)
    index: u64 = 0
    while index < count {
        name := TextFromCString(BundleAssetPath(bundle, index))
        prefix := "assets/"
        entity_picture := TextUntilNul(app.id[:]) == "entity" &&
        (name == "assets/entity/pfp.png" || name == "assets/entity/flowers.png")
        flat_asset := name.count > prefix.count && name[0:prefix.count] == prefix && SafeName(name[prefix.count:name.count])
        if entity_picture || flat_asset {
            data := TextFromBytes(BytesFromPointer(BundleAssetBytes(bundle, index), BundleAssetLength(bundle, index)))
            path: [PATH_LIMIT]u8
            if entity_picture {
                parent: [PATH_LIMIT]u8
                if EnsureDirectory(PathJoin(parent[:], folder, "assets/entity")) {
                    unused WritePrivate(PathJoin(path[:], folder, name), data)
                }
            } else {
                unused WritePrivate(PathJoin(path[:], folder, name[prefix.count:name.count]), data)
            }
        }
        index += 1
    }
}

// Opens one app bundle and asks it who it is. The id is its file name.
LoadApp :: (id: string, path: string) -> bool {
    if app_count >= APP_LIMIT {
        return false
    }
    bytes, found := ReadBundle(path)
    if !found {
        return false
    }
    app := *apps[app_count]
    app.* = App.{}
    app.bundled = id != ""
    CopyField(app.id[:], id)
    app.bytes = bytes
    app.portable.expected_id = id
    app.portable.services = AppCall
    app.portable.widgets = AppWidgetCall
    app.portable.allows = AppServiceAllowed
    app.portable.context = cast(*void)app
    running = app_count
    identified := AppContextOpen(*app.portable, app.bytes)
    running = -1
    if !identified {
        HostedAppClose(*app.portable.app)
        return false
    }
    if id == "" {
        CopyField(app.id[:], TextUntilNul(app.portable.id[:]))
        external_id := TextUntilNul(app.id[:])
        if external_id == "pass" || external_id == "auth" ||
        external_id == "calculator" || external_id == "clock" {
            HostedAppClose(*app.portable.app)
            return false
        }
        for index: 0..app_count - 1 {
            if AppId(index) == external_id {
                HostedAppClose(*app.portable.app)
                return false
            }
        }
    }
    app.local.bundle = app.portable.app.bundle
    app.local.locale = "en"
    CopyField(app.name[:], TextUntilNul(app.portable.name[:]))
    CopyField(app.icon[:], TextUntilNul(app.portable.icon[:]))
    app.started = true
    UnpackAssets(app)
    app_count += 1
    return true
}

LoadApps :: () {
    ids: [BUNDLED_APPS]string = .["pass", "auth", "calculator", "clock"]
    root := BundledAppsRoot()
    if root == "" {
        return
    }
    for index: 0..BUNDLED_APPS - 1 {
        file: [64]u8
        CopyField(file[:], ids[index])
        used := ids[index].count
        suffix := ".zx"
        position: s64 = 0
        while position < suffix.count {
            file[used + position] = suffix[position]
            position += 1
        }
        file[used + suffix.count] = cast(u8)0
        path: [PATH_LIMIT]u8
        unused LoadApp(ids[index], PathJoin(path[:], root, TextUntilNul(file[:])))
    }
    #if #defined(PLATFORM_DESKTOP) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
        workbook_path: [PATH_LIMIT]u8
        unused LoadApp("workbook", PathJoin(workbook_path[:], root, "workbook.zx"))
    }
    entity_path: [PATH_LIMIT]u8
    entity_index = app_count
    if !LoadApp("entity", PathJoin(entity_path[:], root, "entity.zx")) { entity_index = -1 }
}

EntityAppIndex :: () -> s32 { return entity_index }
EntityAppBack :: () -> bool {
    if entity_index < 0 { return false }
    apps[entity_index].portable.command = "back"
    return AppContextRun(*apps[entity_index].portable, APP_COMMAND) && apps[entity_index].portable.reply == "handled"
}

AppFrameReply :: (index: s32) -> string {
    return ifx index >= 0 && index < app_count then apps[index].portable.reply else ""
}

ReloadApp :: (index: s32) {
    if index < 0 || index >= app_count { return }
    apps[index].portable.command = "reload"
    unused AppContextRun(*apps[index].portable, APP_COMMAND)
}

// Draws one frame of an app into the host's session. False when the app
// stopped; it starts again the next time it opens.
RunApp :: (index: s32, view: AppView) -> bool {
    app := *apps[index]
    if app.portable.app.failed {
        app.started = AppContextRestart(*app.portable)
    }
    if !app.started {
        return false
    }
    app_keyboard = false
    app.portable.session = view.session
    app.portable.bounds = view.bounds
    app.portable.dark = view.dark
    app.portable.key = view.key
    app.portable.modifiers = view.modifiers
    app.portable.input = view.input
    app.portable.area_input = TextAreaInputFor(view.key, view.modifiers, view.input.text)
    app.portable.area_input.paste_text = view.input.paste_text
    app.portable.area_input.composition_event = view.input.composition_event
    app.portable.area_input.now_seconds = SteadyClock()
    running = index
    WidgetHostBegin(view.session, AssetAllowed)
    ran := AppContextRun(*app.portable, APP_FRAME)
    app_keyboard = app.portable.keyboard
    WidgetHostEnd()
    ForgetAnswer()
    running = -1
    return ran
}

AppWantsKeyboard :: () -> bool {
    return app_keyboard
}

SaveApp :: (index: s32) -> bool {
    if index < 0 || index >= app_count || !apps[index].started {
        return true
    }
    running = index
    saved := AppContextRun(*apps[index].portable, APP_SAVE)
    ForgetAnswer()
    running = -1
    return saved
}

SaveApps :: () -> bool {
    saved := true
    for index: 0..app_count - 1 {
        if !SaveApp(index) {
            saved = false
        }
    }
    return saved
}


// Explicit local bundle launch uses the same checked lifecycle as built-ins.
LoadExternalApp :: (path: string) -> s32 {
    bytes, found := ReadBundle(path)
    if !found { return -1 }
    defer { AppFileFree(bytes) }
    for current: 0..app_count - 1 {
        if apps[current].bytes == bytes { return cast(s32)current }
    }
    index := app_count
    return ifx LoadApp("", path) then index else -1
}


AppWidgetCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    #if #defined(ANDROID_BUILD) {
        return AndroidWidgetCall(context, module, function, arguments, count, result)
    } else {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
}

#if #defined(PLATFORM_DESKTOP) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
    input_text: [8192]u8;
    InputCall :: (app: *App, request: string, result: *HostValue) {
        if request == "clipboard-has-text" { ReturnText(result, ifx SystemClipboardHasText() then "true" else "false"); return }
        if request == "clipboard" {
            text := SystemClipboardText(input_text[:])
            result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"), .data = HostTextData(text), .length = cast(usize)text.count}
            return
        }
        if request.count > 0 && request[0] == cast(u8)123 {
            operation: [32]u8
            used := Json.ReadStringText(request, Json.FieldAt(request, 0, "op"), operation[:])
            if used == 7 && TextUntilNul(operation[:]) == "measure" {
                content: [8192]u8
                length := Json.ReadStringText(request, Json.FieldAt(request, 0, "text"), content[:])
                if length >= 0 {
                    digits: [24]u8
                    bytes: Vec(u8)
                    BuilderPrint(*bytes, "{\"width\":%}", Font.GlyphWidth(TextView(content[:length]), 14, ""))
                    value := BuilderFinish(bytes)
                    ReturnText(result, value); AppFileFree(value); return
                }
            }
        }
        if request != "frame" { ReturnText(result, "{}"); return }
        session := app.portable.session
        p := PointerSample(session); q := SecondaryPointerSample(session)
        wheel := PointerWheelTake(session, app.portable.bounds)
        text: Vec(u8)
        BuilderPrint(*text, "{\"x\":%,\"y\":%,\"down\":%,\"pressed\":%,\"released\":%,\"secondary_down\":%,\"secondary_pressed\":%,\"secondary_released\":%,\"wheel\":%}",
            cast(s32)p.x, cast(s32)p.y, ifx p.down then 1 else 0, ifx p.pressed then 1 else 0, ifx p.released then 1 else 0,
            ifx q.down then 1 else 0, ifx q.pressed then 1 else 0, ifx q.released then 1 else 0, cast(s32)wheel)
        value := BuilderFinish(text)
        ReturnText(result, value)
        AppFileFree(value)
    }
    // A picker grants just the selected transfer. Bundles never receive an
    // arbitrary filesystem path; their editable copy remains in their folder.
    DocumentPick :: (app: *App, request: string) -> string {
        if request.count > 4096 { return "error" }
        operation_bytes: [32]u8
        name_bytes: [256]u8
        filter_bytes: [256]u8
        suggestion_bytes: [256]u8
        operation := ServiceText(request, "op", operation_bytes[:])
        name := ServiceText(request, "name", name_bytes[:])
        if (operation != "import" && operation != "export") || !AppFileNameValid(name) { return "error" }
        props: Picker.FilePickerProps
        props.title = ifx operation == "export" then "Save document" else "Open document"
        props.filter = ServiceText(request, "filter", filter_bytes[:])
        props.suggested_name = ServiceText(request, "suggested_name", suggestion_bytes[:])
        props.save = operation == "export"
        path: [4096]u8
        selected := Picker.PickFile(props, path[:])
        if selected == 0 { return "cancelled" }
        if selected != 1 { return "error" }
        if operation == "export" {
            value := AppFileRead(*app.local.files, name)
            defer { AppFileFree(value) }
            return ifx app.local.files.status == 1 && WritePrivate(TextUntilNul(path[:]), value) then "ready" else "error"
        }
        file := OpenRead(TextUntilNul(path[:]))
        if !file.valid { return "error" }
        defer { unused CloseFile(file) }
        count := FileSize(file)
        if count < 1 || count > 67108864 { return "error" }
        bytes: Vec(u8)
        chunk: [4096]u8
        offset: s64 = 0
        while offset < count {
            used := ReadAt(file, chunk[:], offset)
            if used <= 0 { return "error" }
            for index: 0..used - 1 { if !VecPush(bytes, chunk[index]) { return "error" } }
            offset += used
            if offset > 67108864 { return "error" }
        }
        value := BuilderFinish(bytes)
        defer { AppFileFree(value) }
        return ifx AppFileWrite(*app.local.files, name, value) then "ready" else "error"
    }
}

#if #defined(PLATFORM_DESKTOP) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
    ExportBundle :: (app: *App) -> string {
        name: [256]u8
        CopyField(name[:], TextUntilNul(app.id[:]))
        used := TextUntilNul(name[:]).count
        suffix := ".zx"
        for index: 0..suffix.count - 1 { name[used + index] = suffix[index] }
        name[used + suffix.count] = 0
        path: [4096]u8
        props := Picker.FilePickerProps.{.title = "Download app bundle", .filter = "App bundle | *.zx", .save = true, .suggested_name = TextUntilNul(name[:])}
        selected := Picker.PickFile(props, path[:])
        if selected == 0 { return "cancelled" }
        if selected != 1 { return "error" }
        return ifx WritePrivate(TextUntilNul(path[:]), app.bytes) then "ready" else "error"
    }
}

#if #defined(PLATFORM_DESKTOP) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
    ServiceText :: (request: string, field: string, out: []u8) -> string {
        count := Json.ReadStringText(request, Json.FieldAt(request, 0, field), out)
        return ifx count >= 0 && count < out.count then TextView(out[:count]) else ""
    }
}
