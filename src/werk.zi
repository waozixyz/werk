// Werkzeug's own screens: the home screen of apps, the profile, and the bar
// above the app that is open.
#import "std/byte_text_linux"
#import "std/text_buffer"
#import "std/c_string"
using UI :: #import "kryon/Widgets";
#import "kryon/key_input"
#import "kryon/ScrollDevice"
#import "kryon/Theme"
#import "apps"
#import "profile"
#import "platform"
#import "migrate"
#import "node_url"
#if #defined(ANDROID_BUILD) {
    #import "android_fields"
}
#if !#defined(PLATFORM_WEB) {
    #import "account"
    #import "sync"
    #import "device_link"
}
Back :: #import "mingcute/mingcute_regular_left";

SCREEN_HOME :: 0
SCREEN_APP :: 1
SCREEN_PROFILE :: 2
BAR_HEIGHT :: 56.0

FieldState :: struct {
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
}

screen: s32;
open_app: s32 = -1;
// Started in a page embedding the toolkit, with navigation still available.
mini: bool;
name_field: FieldState;
code_field: FieldState;
code_text: [32]u8;
node_field: FieldState;
node_text: [256]u8;
node_error: bool;
// A Daochi account key to sign in with, such as Inbe's, and its passphrase.
account_key_field: FieldState;
account_key_text: [17664]u8;
passphrase_field: FieldState;
passphrase_text: [512]u8;
account_key_status: [96]u8;
// The value a secret field draws, apart from the buffer its edit changes.
secret_snapshot: [17664]u8;
// Stop syncing was tapped once; a second tap forgets the account here.
forget_pending: bool;
choosing_picture: bool;
profile_scroll: s32;
// Where Profile's focused field was drawn, so Profile can scroll it into
// view when it gains focus or the keyboard changes the visible height.
focused_top: float32;
focused_bottom: float32;
revealed_field: s32;
profile_height: float32;
typed: [256]u8;
keyboard_wanted: bool;
WerkStart :: () {
    MigratePassData()
    LoadProfile()
    unused CopyCString(ProfileNode(), node_text[:])
    LoadApps()
    #if !#defined(PLATFORM_WEB) {
        LoadAccount()
    }
}

// Opens an app by id at start, such as from the page address. In mini mode
// the host keeps navigation so every tool remains available.
WerkOpen :: (id: string, alone: bool) -> bool {
    index: s32 = 0
    while index < AppCount() {
        if AppId(index) == id {
            if open_app != index && !SaveApp(open_app) {
                return false
            }
            open_app = index
            screen = SCREEN_APP
            mini = alone
            return true
        }
        index += 1
    }
    return false
}

// Whether the touch keyboard should show.
WerkKeyboard :: () -> bool {
    return keyboard_wanted
}

Label :: (session: Session, key: u64, text: string, bounds: Rectangle, font: s32) {
    Text(session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = font,
            .wrap = TextWrap.TextWrapEllipsis})
}

Action :: (session: Session, id: s32, label: string, bounds: Rectangle, selected: bool) -> bool {
    props := ButtonProps.{.key = cast(u64)id, .id = id, .bounds = bounds, .label = label,
        .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
    if selected {
        props.tone = ButtonTone.ButtonToneAccent
        props.emphasis = ButtonEmphasis.ButtonEmphasisFilled
    }
    return Button(session, props) != 0
}

OpenHome :: () {
    if screen == SCREEN_APP && !SaveApp(open_app) {
        return
    }
    if screen == SCREEN_PROFILE {
        name_field.focused = false
        code_field.focused = false
        node_field.focused = false
        ForgetKeyFields()
        account_key_status[0] = cast(u8)0
        forget_pending = false
        unused SaveProfile()
    }
    screen = SCREEN_HOME
    open_app = -1
    choosing_picture = false
}

TopBar :: (session: Session, viewport: Rectangle) {
    bar := Rectangle.{viewport.x, viewport.y, viewport.width, BAR_HEIGHT}
    title := "Werkzeug"
    left := bar.x + 16.0
    if screen != SCREEN_HOME {
        back := ButtonProps.{.key = cast(u64)10, .id = 10, .label = "Home",
            .bounds = Rectangle.{bar.x + 8.0, bar.y + 8.0, 40.0, 40.0},
            .icon_shape = Back.Shape, .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
        if Button(session, back) != 0 {
            OpenHome()
            return
        }
        left = bar.x + 56.0
        title = ifx screen == SCREEN_APP then AppName(open_app) else "Profile"
    }
    // The profile button names itself, with the picture beside the name.
    profile_width: float32 = 0.0
    if screen == SCREEN_HOME {
        profile_width = 150.0
    }
    Label(session, cast(u64)11, title, Rectangle.{left, bar.y + 16.0,
            bar.width - left - profile_width - 24.0, 26.0}, 20)
    if screen == SCREEN_HOME {
        avatar := ButtonProps.{.key = cast(u64)12, .id = 12,
            .label = ifx ProfileName() == "" then "Profile" else ProfileName(),
            .bounds = Rectangle.{bar.x + bar.width - profile_width - 8.0, bar.y + 8.0, profile_width, 40.0},
            .image = PictureImage(profile.picture, Rectangle.{}),
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
        if Button(session, avatar) != 0 {
            screen = SCREEN_PROFILE
        }
    }
}

Home :: (session: Session, area: Rectangle) {
    tile: float32 = 120.0
    gap: float32 = 16.0
    columns := cast(s32)((area.width - gap) / (tile + gap))
    if columns < 2 {
        columns = 2
        tile = (area.width - gap * 3.0) / 2.0
    }
    if columns > AppCount() && AppCount() > 0 {
        columns = AppCount()
    }
    if AppCount() == 0 {
        Label(session, cast(u64)20, "No apps are installed.", Rectangle.{area.x + 16.0, area.y + 16.0,
                area.width - 32.0, 24.0}, 16)
        return
    }
    row_width := cast(float32)columns * tile + cast(float32)(columns - 1) * gap
    left := area.x + (area.width - row_width) * 0.5
    index: s32 = 0
    while index < AppCount() {
        column := cast(float32)(index % columns)
        row := cast(float32)(index / columns)
        bounds := Rectangle.{left + column * (tile + gap), area.y + gap + row * (tile + gap), tile, tile}
        props := ButtonProps.{.key = cast(u64)(100 + index), .id = 100 + index, .bounds = bounds,
            .label = AppName(index), .icon_shape = AppIcon(index),
            .icon_placement = IconPlacement.IconPlacementAbove,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
        if Button(session, props) != 0 {
            open_app = index
            screen = SCREEN_APP
        }
        index += 1
    }
}

// Applies a text field's edit to a terminated buffer.
ApplyEdit :: (buffer: []u8, edit: TextFieldEdit) {
    if !edit.changed {
        return
    }
    length: s64 = 0
    while length < buffer.count && buffer[length] != cast(u8)0 {
        length += 1
    }
    if edit.start < 0 || edit.end < edit.start || cast(s64)edit.end > length {
        return
    }
    used := length - cast(s64)(edit.end - edit.start) + edit.replacement.count
    if used >= buffer.count || used >= 256 {
        return
    }
    result: [256]u8
    position: s64 = 0
    index: s64 = 0
    while index < cast(s64)edit.start {
        result[position] = buffer[index]
        position += 1
        index += 1
    }
    index = 0
    while index < edit.replacement.count {
        // One line: a pasted line break ends the name.
        if edit.replacement[index] == cast(u8)10 || edit.replacement[index] == cast(u8)13 {
            return
        }
        result[position] = edit.replacement[index]
        position += 1
        index += 1
    }
    index = cast(s64)edit.end
    while index < length {
        result[position] = buffer[index]
        position += 1
        index += 1
    }
    index = 0
    while index < buffer.count {
        buffer[index] = ifx index < used then result[index] else cast(u8)0
        index += 1
    }
}

NameField :: (session: Session, bounds: Rectangle, input: TextFieldInput) {
    #if #defined(ANDROID_BUILD) {
        if name_field.focused {
            AndroidFieldRead(30, profile.name[:], *name_field.cursor, *name_field.anchor)
        }
    }
    props := TextFieldProps.{.key = cast(u64)30, .focus_id = 30, .bounds = bounds,
        .label = "Name", .placeholder = "Your name", .value = ProfileName(),
        .cursor = name_field.cursor, .anchor = name_field.anchor, .scroll_x = name_field.scroll_x,
        .focused = name_field.focused, .max_bytes = 160, .max_codepoints = PROFILE_NAME_LIMIT}
    if name_field.focused {
        props.input = input
    }
    #if #defined(ANDROID_BUILD) {
        // The input method edits the name through Android's EditText.
        if name_field.focused {
            props.input = TextFieldInput.{}
        }
    }
    result := TextField(session, props)
    if result.focused {
        focused_top = bounds.y
        focused_bottom = bounds.y + bounds.height
    }
    ApplyEdit(profile.name[:], result.edit)
    name_field.cursor = result.cursor
    name_field.anchor = result.anchor
    name_field.scroll_x = result.scroll_x
    #if #defined(ANDROID_BUILD) {
        if result.focused {
            AndroidFieldSubmit(30, profile.name[:], name_field.cursor, name_field.anchor)
        }
    }
    was_focused := name_field.focused
    name_field.focused = result.focused && !result.escaped
    if was_focused && (!name_field.focused || result.committed) {
        name_field.focused = false
        unused SaveProfile()
    }
}

Heading :: (session: Session, key: u64, text: string, x: float32, y: float32, width: float32) {
    Label(session, key, text, Rectangle.{x, y, width, 24.0}, 16)
}

// Scrolls the field drawn focused last frame just into view, once when it
// gains focus and again whenever the visible height changes, as when the
// keyboard opens; scrolling by hand while typing is left alone.
RevealFocusedField :: (area: Rectangle) {
    field: s32 = 0
    if name_field.focused {
        field = 30
    }
    if code_field.focused {
        field = 31
    }
    if node_field.focused {
        field = 32
    }
    if account_key_field.focused {
        field = 33
    }
    if passphrase_field.focused {
        field = 34
    }
    if field != 0 && (field != revealed_field || area.height != profile_height) {
        margin: float32 = 16.0
        if focused_bottom + margin > area.y + area.height {
            profile_scroll += cast(s32)(focused_bottom + margin - area.y - area.height)
        } else if focused_top - margin < area.y {
            profile_scroll -= cast(s32)(area.y - focused_top + margin)
            if profile_scroll < 0 {
                profile_scroll = 0
            }
        }
    }
    revealed_field = field
    profile_height = area.height
}

ProfileScreen :: (session: Session, area: Rectangle, input: TextFieldInput) {
    width := area.width - 32.0
    if width > 480.0 {
        width = 480.0
    }
    left := area.x + (area.width - width) * 0.5
    content_height: s32 = 620 + 500
    if choosing_picture {
        content_height += cast(s32)((PROFILE_PICTURES + 5) / 6) * 56 + 16
    }
    RevealFocusedField(area)
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)40,
            .bounds = Rectangle.{left, area.y, width, area.height},
            .content_height = content_height, .scroll_offset = profile_scroll, .scale = 1.0})
    profile_scroll = scroll.scroll_offset
    if !scroll.opened {
        return
    }
    x := scroll.content.x
    y := scroll.content.y + 16.0
    width = scroll.content.width - 12.0
    Image(session, PictureImage(profile.picture, Rectangle.{x, y, 96.0, 96.0}))
    if Action(session, 41, ifx choosing_picture then "Done" else "Change picture",
        Rectangle.{x + 112.0, y + 28.0, width - 112.0, 40.0}, false) {
        choosing_picture = !choosing_picture
    }
    y += 112.0
    if choosing_picture {
        size: float32 = 48.0
        gap := (width - size * 6.0) / 5.0
        picture: s32 = 0
        while picture < PROFILE_PICTURES {
            bounds := Rectangle.{x + cast(float32)(picture % 6) * (size + gap),
                y + cast(float32)(picture / 6) * (size + 8.0), size, size}
            choice := ButtonProps.{.key = cast(u64)(200 + picture), .id = 200 + picture,
                .label = "Picture", .bounds = bounds, .icon_only = true,
                .image = PictureImage(picture, Rectangle.{}), .selected = picture == profile.picture,
                .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
            if Button(session, choice) != 0 {
                profile.picture = picture
                unused SaveProfile()
            }
            picture += 1
        }
        y += cast(float32)((PROFILE_PICTURES + 5) / 6) * (size + 8.0) + 16.0
    }
    Heading(session, cast(u64)42, "Name", x, y, width)
    NameField(session, Rectangle.{x, y + 28.0, width, 40.0}, input)
    y += 88.0
    Heading(session, cast(u64)43, "Appearance", x, y, width)
    y += 32.0
    modes: [3]string = .["System", "Light", "Dark"]
    third := (width - 16.0) / 3.0
    for index: 0..2 {
        mode := cast(s32)index
        if Action(session, 50 + mode, modes[index],
            Rectangle.{x + cast(float32)mode * (third + 8.0), y, third, 40.0}, profile.theme_mode == mode) {
            profile.theme_mode = mode
            unused SaveProfile()
        }
    }
    y += 56.0
    Heading(session, cast(u64)44, "Accent", x, y, width)
    y += 32.0
    swatch: float32 = 40.0
    swatch_gap := (width - swatch * 8.0) / 7.0
    accent: s32 = 0
    while accent < ACCENTS {
        bounds := Rectangle.{x + cast(float32)(accent % 8) * (swatch + swatch_gap),
            y + cast(float32)(accent / 8) * (swatch + 8.0), swatch, swatch}
        props := ButtonProps.{.key = cast(u64)(300 + accent), .id = 300 + accent, .label = "Accent",
            .bounds = bounds, .swatch = true, .swatch_color = ColorFromPacked(Accent(accent)),
            .icon_only = true, .selected = profile.accent == accent}
        if Button(session, props) != 0 {
            profile.accent = accent
            unused SaveProfile()
        }
        accent += 1
    }
    y += swatch * 2.0 + 24.0
    Heading(session, cast(u64)45, "Widgets", x, y, width)
    y += 32.0
    half := (width - 8.0) / 2.0
    if Action(session, 60, "Material", Rectangle.{x, y, half, 40.0}, profile.material) {
        profile.material = true
        unused SaveProfile()
    }
    if Action(session, 61, "Classic", Rectangle.{x + half + 8.0, y, half, 40.0}, !profile.material) {
        profile.material = false
        unused SaveProfile()
    }
    y += 64.0
    SyncSection(session, x, y, width, input)
    End(session)
}

Note :: (session: Session, key: u64, text: string, x: float32, y: float32, width: float32) {
    Text(session, TextProps.{.key = key, .bounds = Rectangle.{x, y, width, 40.0}, .text = text, .font = 14,
            .wrap = TextWrap.TextWrapAuto})
}

CodeText :: () -> string {
    return TextUntilNul(code_text[:])
}

CodeField :: (session: Session, bounds: Rectangle, input: TextFieldInput, buffer: []u8) {
    edit: TextFieldEdit
    focused := false
    finished := false
    #if #defined(ANDROID_BUILD) {
        if code_field.focused {
            AndroidFieldRead(31, buffer, *code_field.cursor, *code_field.anchor)
        }
    }
    {
        props := TextFieldProps.{.key = cast(u64)31, .focus_id = 31, .bounds = bounds,
            .label = "Code", .placeholder = "Code from your other device", .value = CodeText(),
            .cursor = code_field.cursor, .anchor = code_field.anchor, .scroll_x = code_field.scroll_x,
            .focused = code_field.focused, .max_bytes = 20, .max_codepoints = 20}
        if code_field.focused {
            props.input = input
        }
        #if #defined(ANDROID_BUILD) {
            if code_field.focused {
                props.input = TextFieldInput.{}
            }
        }
        result := TextField(session, props)
        if result.focused {
            focused_top = bounds.y
            focused_bottom = bounds.y + bounds.height
        }
        code_field.cursor = result.cursor
        code_field.anchor = result.anchor
        code_field.scroll_x = result.scroll_x
        focused = result.focused
        finished = result.escaped || result.committed
        edit = result.edit
    }
    ApplyEdit(buffer, edit)
    #if #defined(ANDROID_BUILD) {
        if focused {
            AndroidFieldSubmit(31, buffer, code_field.cursor, code_field.anchor)
        }
    }
    code_field.focused = focused && !finished
}

NodeField :: (session: Session, bounds: Rectangle, input: TextFieldInput) {
    edit: TextFieldEdit
    focused := false
    finished := false
    snapshot: [256]u8
    #if #defined(ANDROID_BUILD) {
        if node_field.focused {
            AndroidFieldRead(32, node_text[:], *node_field.cursor, *node_field.anchor)
        }
    }
    {
        snapshot = node_text
        props := TextFieldProps.{.key = cast(u64)32, .focus_id = 32, .bounds = bounds,
            .label = "Daochi node", .placeholder = "https://your-node.example", .value = TextUntilNul(snapshot[:]),
            .cursor = node_field.cursor, .anchor = node_field.anchor, .scroll_x = node_field.scroll_x,
            .focused = node_field.focused, .max_bytes = 255, .max_codepoints = 255}
        if node_field.focused {
            props.input = input
        }
        #if #defined(ANDROID_BUILD) {
            if node_field.focused {
                props.input = TextFieldInput.{}
            }
        }
        result := TextField(session, props)
        if result.focused {
            focused_top = bounds.y
            focused_bottom = bounds.y + bounds.height
        }
        edit = result.edit
        node_field.cursor = result.cursor
        node_field.anchor = result.anchor
        node_field.scroll_x = result.scroll_x
        focused = result.focused
        finished = result.escaped || result.committed
    }
    ApplyEdit(node_text[:], edit)
    #if #defined(ANDROID_BUILD) {
        if focused {
            AndroidFieldSubmit(32, node_text[:], node_field.cursor, node_field.anchor)
        }
    }
    node_field.focused = focused && !finished
}

ForgetKeyFields :: () {
    for index: 0..account_key_text.count - 1 {
        account_key_text[index] = cast(u8)0
    }
    for index: 0..passphrase_text.count - 1 {
        passphrase_text[index] = cast(u8)0
    }
    for index: 0..secret_snapshot.count - 1 {
        secret_snapshot[index] = cast(u8)0
    }
    account_key_field = FieldState.{}
    passphrase_field = FieldState.{}
}

// A field whose value shows as dots, for the account key and passphrase.
SecretField :: (session: Session, bounds: Rectangle, input: TextFieldInput, id: s32, state: *FieldState,
    label: string, placeholder: string, buffer: []u8) {
    edit: TextFieldEdit
    focused := false
    finished := false
    index: s64 = 0
    while index < buffer.count {
        secret_snapshot[index] = buffer[index]
        index += 1
    }
    secret_snapshot[buffer.count - 1] = cast(u8)0
    {
        props := TextFieldProps.{.key = cast(u64)id, .focus_id = id, .bounds = bounds, .label = label,
            .placeholder = placeholder, .value = TextUntilNul(secret_snapshot[:]), .cursor = state.cursor,
            .anchor = state.anchor,
            .scroll_x = state.scroll_x, .focused = state.focused, .max_bytes = cast(s32)buffer.count - 1,
            .max_codepoints = cast(s32)buffer.count - 1, .secure = true}
        if buffer[0] != cast(u8)0 {
            props.display_value = "••••••••"
        }
        if state.focused {
            props.input = input
        }
        result := TextField(session, props)
        if result.focused {
            focused_top = bounds.y
            focused_bottom = bounds.y + bounds.height
        }
        state.cursor = result.cursor
        state.anchor = result.anchor
        state.scroll_x = result.scroll_x
        focused = result.focused
        finished = result.escaped || result.committed
        edit = result.edit
    }
    ApplyEdit(buffer, edit)
    state.focused = focused && !finished
}

SaveNode :: () -> bool {
    snapshot := node_text
    value := NodeOrigin(TextUntilNul(snapshot[:]))
    node_error = value == ""
    if node_error {
        return false
    }
    previous := profile.node
    unused CopyCString(value, profile.node[:])
    if !SaveProfile() {
        profile.node = previous
        node_error = true
        return false
    }
    node_field.focused = false
    return true
}

// The account that syncs Auth: create one, connect to one, or connect
// another device to it.
SyncSection :: (session: Session, x: float32, y: float32, width: float32, input: TextFieldInput) {
    Heading(session, cast(u64)46, "Sync", x, y, width)
    y += 32.0
    #if #defined(PLATFORM_WEB) {
        Note(session, cast(u64)47, "Sync Auth between your devices in the desktop and Android apps.", x, y, width)
    } else {
        half := (width - 8.0) / 2.0
        phase := LinkPhaseNow()
        if !AccountReady() {
            Note(session, cast(u64)47,
                "Sync is optional and off. Every tool works locally. Choose a node before creating or connecting an account.",
                x, y, width)
            y += 48.0
            if phase == LinkPhase.LinkJoining {
                Label(session, cast(u64)48, LinkStatus(), Rectangle.{x, y, width, 20.0}, 14)
                if Action(session, 72, "Cancel", Rectangle.{x, y + 28.0, width, 40.0}, false) {
                    LinkCancel()
                }
                return
            }
            NodeField(session, Rectangle.{x, y, width, 44.0}, input)
            y += 52.0
            if Action(session, 78, "Save node", Rectangle.{x, y, width, 40.0}, false) {
                unused SaveNode()
            }
            y += 48.0
            if node_error {
                Note(session, cast(u64)79, "Enter an HTTPS node address. HTTP works for localhost. Check that settings can be saved.",
                    x, y, width)
                y += 48.0
            }
            if Action(session, 70, "Create account", Rectangle.{x, y, width, 40.0}, false) {
                if !SaveNode() || !CreateAccount() {
                    Label(session, cast(u64)48, "Could not create the account", Rectangle.{x, y + 104.0, width, 20.0}, 14)
                } else {
                    SyncNow()
                }
            }
            y += 56.0
            Label(session, cast(u64)49, "Or connect to the account on another device:", Rectangle.{x, y, width, 20.0}, 14)
            y += 24.0
            CodeField(session, Rectangle.{x, y, width - 120.0, 40.0}, input, code_text[:])
            if Action(session, 71, "Connect", Rectangle.{x + width - 112.0, y, 112.0, 40.0}, false) {
                code_field.focused = false
                if SaveNode() {
                    LinkJoin(TextUntilNul(code_text[:]))
                }
            }
            y += 48.0
            if phase == LinkPhase.LinkFailed {
                Label(session, cast(u64)48, LinkStatus(), Rectangle.{x, y, width, 20.0}, 14)
                y += 28.0
            }
            // Phones connect with a code; their text fields hold less than a key.
            #if !#defined(ANDROID_BUILD) {
                y += 8.0
                Note(session, cast(u64)84, "Or sign in with a Daochi account key, such as the one Inbe exports:", x, y,
                    width)
                y += 40.0
                SecretField(session, Rectangle.{x, y, width, 40.0}, input, 33, *account_key_field, "Account key",
                    "Paste the account key", account_key_text[:])
                y += 48.0
                SecretField(session, Rectangle.{x, y, width, 40.0}, input, 34, *passphrase_field, "Passphrase",
                    "Its passphrase, if it has one", passphrase_text[:])
                y += 48.0
                if Action(session, 85, "Sign in with key", Rectangle.{x, y, width, 40.0}, false) {
                    account_key_field.focused = false
                    passphrase_field.focused = false
                    problem := "Enter an HTTPS node address first"
                    if SaveNode() {
                        problem = UseAccountKey(TextUntilNul(account_key_text[:]), TextUntilNul(passphrase_text[:]))
                    }
                    unused CopyCString(problem, account_key_status[:])
                    if problem == "" {
                        ForgetKeyFields()
                        SyncNow()
                    }
                }
                y += 48.0
                if account_key_status[0] != cast(u8)0 {
                    Label(session, cast(u64)86, TextUntilNul(account_key_status[:]), Rectangle.{x, y, width, 20.0}, 14)
                }
            }
            return
        }
        Label(session, cast(u64)80, AccountServer(), Rectangle.{x, y, width, 24.0}, 14)
        y += 32.0
        enabled := AccountSyncEnabled()
        Label(session, cast(u64)83, "Sync with Daochi", Rectangle.{x, y + 8.0, width - 80.0, 24.0}, 14)
        toggle := Toggle(session, ToggleProps.{.key = cast(u64)81, .id = 81,
                .bounds = Rectangle.{x + width - 64.0, y, 64.0, 40.0}, .label = "Sync with Daochi", .value = enabled})
        if toggle.changed && SetAccountSyncEnabled(toggle.value) {
            if !toggle.value {
                CancelSyncNow()
                LinkCancel()
            } else {
                SyncNow()
            }
        }
        y += 48.0
        if !AccountSyncEnabled() {
            Note(session, cast(u64)82, "Sync is off. Your account and records stay on this device.", x, y, width)
            y += 48.0
        }
        status := ifx SyncStatus() == "" then "Sync is on" else SyncStatus()
        if AccountSyncEnabled() {
            Label(session, cast(u64)47, status, Rectangle.{x, y, width, 20.0}, 14)
            y += 28.0
        }
        if AccountSyncEnabled() && Action(session, 73, "Sync now", Rectangle.{x, y, half, 40.0}, false) {
            SyncNow()
        }
        if AccountSyncEnabled() && Action(session, 74, "Connect a device", Rectangle.{x + half + 8.0, y, half, 40.0},
            phase == LinkPhase.LinkShowing) {
            if phase == LinkPhase.LinkShowing {
                LinkCancel()
            } else {
                LinkShow()
            }
        }
        y += 56.0
        if phase == LinkPhase.LinkShowing {
            shown: [16]u8
            Text(session, TextProps.{.key = cast(u64)75, .bounds = Rectangle.{x, y, width, 40.0},
                    .text = LinkCodeText(shown[:]), .font = 28, .align = TextAlign.TextAlignCenter})
            y += 48.0
            Note(session, cast(u64)76,
                "On your other device, open Profile, then Sync, and enter this code. It works for 10 minutes.",
                x, y, width)
            y += 48.0
        } else if phase != LinkPhase.LinkIdle {
            Label(session, cast(u64)76, LinkStatus(), Rectangle.{x, y, width, 20.0}, 14)
            y += 28.0
        }
        if Action(session, 77, ifx forget_pending then "Tap again to forget account here" else "Forget account on this device",
            Rectangle.{x, y, width, 40.0}, false) {
            if forget_pending {
                CancelSyncNow()
                LinkCancel()
                ForgetSync()
                unused ForgetAccount()
                forget_pending = false
            } else {
                forget_pending = true
            }
        }
    }
}

AppScreen :: (session: Session, area: Rectangle, key: s32, modifiers: s32, input: TextFieldInput) {
    view := AppView.{.session = session, .bounds = area, .dark = ProfileDark(), .key = key,
        .modifiers = modifiers, .input = input}
    // The app's widgets live in their own container, so their keys never
    // meet the host's.
    container := Group(session, ColumnProps.{.key = cast(u64)69, .bounds = area})
    if !container.opened {
        return
    }
    ran := RunApp(open_app, view)
    unused End(session)
    if !ran {
        Label(session, cast(u64)70, "This app stopped. Go back and open it again.",
            Rectangle.{area.x + 16.0, area.y + 16.0, area.width - 32.0, 24.0}, 16)
    }
    keyboard_wanted = AppWantsKeyboard()
}

#program_export
WerkFrame :: (session: Session, viewport: Rectangle) -> s32 {
    ApplyTheme()
    ClipboardTick()
    #if !#defined(PLATFORM_WEB) {
        SyncFrame()
        LinkFrame()
    }
    key := KeyboardTake(session)
    modifiers := KeyboardModifiers(session)
    text := TypedTextTake(session, typed[:])
    input := TextFieldInputFor(key, modifiers, text)
    pointer := PointerSample(session)
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed, pointer.down,
        pointer.released, PointerWheelTake(session, viewport), SteadyClock())
    background := BoxProps.{.key = cast(u64)1, .bounds = viewport,
        .fill = ColorFromPacked(ThemePalette().background)}
    Box(session, background)
    keyboard_wanted = false
    content := viewport
    TopBar(session, viewport)
    content = Rectangle.{viewport.x, viewport.y + BAR_HEIGHT, viewport.width, viewport.height - BAR_HEIGHT}
    if screen == SCREEN_HOME {
        Home(session, content)
    } else if screen == SCREEN_PROFILE {
        ProfileScreen(session, content, input)
        keyboard_wanted = name_field.focused || code_field.focused || node_field.focused
    } else if screen == SCREEN_APP && open_app >= 0 {
        AppScreen(session, content, key, modifiers, input)
    }
    return 0
}
